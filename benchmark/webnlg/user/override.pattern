// User-maintained compact lexicon additions/overrides.
// Format: LEXEME<TAB>POS<TAB>LEMMA<TAB>features_1
// Keep this file in Elvex elvexlexicon pattern format.
//
// frame_for:<predicate-head> means: this lexical resource belongs to a
// predicate-specific rule frame. The automatic predicate entry for that
// predicate is then skipped when main.pattern is generated.
_LEADER	common_noun	_LEADER	[HEAD:_LEADER, frame_for:leader_Name]
_RUNWAY_LENGTH	common_noun	_RUNWAY_LENGTH	[HEAD:_RUNWAY_LENGTH, frame_for:runway_Length]
_RUNWAY_NAME	common_noun	_RUNWAY_NAME	[HEAD:_RUNWAY_NAME, frame_for:runway_Name|runway_Designation]
_LOCATION_IDENTIFIER	common_noun	_LOCATION_IDENTIFIER	[HEAD:_LOCATION_IDENTIFIER, frame_for:faa|location_Identifier]
_FIRST_RUNWAY_LENGTH_IN_FEET	common_noun	_FIRST_RUNWAY_LENGTH_IN_FEET	[HEAD:_FIRST_RUNWAY_LENGTH_IN_FEET, frame_for:P_1st_runway_Length_Feet|r1_Length_F]
_SERVE	vrel	_SERVE	[HEAD:_SERVE, frame_for:city|city_Served]
_OPERATING_ORGANISATION	common_noun	_OPERATING_ORGANISATION	[HEAD:_OPERATING_ORGANISATION, frame_for:operator|operating_Organisation]
_OWNER	common_noun	_OWNER	[HEAD:_OWNER, frame_for:owner]
_ELEVATION	common_noun	_ELEVATION	[HEAD:_ELEVATION, frame_for:elevation_M|elevation|elevation_Above_The_Sea_Level_in_metres]


