@s=     [number:singular];
@p=     [number:plural];
@m=     [gender:masc];
@f=     [gender:fem];
@ms=    [@m, @s];
@mp=    [@m, @p];
@fs=    [@f, @s];
@fp=    [@f, @p];
@_1=    [person:one];
@_2=    [person:two];
@_12=   [person:one|two];
@_3=    [person:three];
@_1s=   [@_1, @s];
@_2s=   [@_2, @s];
@_12s=  [@_12, @s];
@_3s=   [@_3, @s];
@_1p=   [@_1, @p];
@_2p=   [@_2, @p];
@_12p=  [@_12, @p];
@_3p=   [@_3, @p];
@_3ms=  [@_3, @ms];
@_3mp=  [@_3, @mp];
@_3fs=  [@_3, @fs];
@_3fp=  [@_3, @fp];
@def=   [def:true];
@indef= [indef:true, def:false, poss:false, part:false, dem:false];
@present= [tense:present];
@past= [tense:past];
@indicative= [mode:indicative];
