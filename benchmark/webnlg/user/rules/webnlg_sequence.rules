/* Possessive relative fragments for same-subject/same-object pairs. */
RELSEQ -> _which_ cop det common_noun {
  [HEAD:poss_rel_for, p:[HEAD:canton]];
  ↓1 = [];
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = [@s, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_3s, human:false]];
  ↓4 = [HEAD:_CANTON_NOUN, @s];
  ⇑ = ⇓4;
}

