/************************************************************
 * WebNLG multi-triple sequence rules.
 *
 * v38 assumes that generated inputs carry local ID features on every
 * subject, predicate, and object.  After the Elvex guard-binding fix, repeated
 * variables in guards are true equality constraints.  These rules therefore
 * detect local co-reference structurally, without precomputed rel:same_subject
 * flags in the input.
 ************************************************************/

S -> SENT dot {
  [HEAD:webnlg_sequence];

  ↓1 = ↑;
  ↓2 = [];

  ⇑ = ⇓1;
}

/* Exact semantic duplicate: same subject, predicate, and object IDs. */
SENT -> SENT {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$Pat1, s:$S, p:$P, o:$O],
   ii:[pattern:$Pat2, s:$S, p:$P, o:$O]];

  ↓1 = [HEAD:webnlg_simple, pattern:$Pat1, s:$S, p:$P, o:$O];

  ⇑ = ⇓1;
}


/* Same subject and same object, with one predicate realized as a
 * possessive relational noun.  This generalizes cases such as
 * location(X,Y) + canton(X,Y): the main fact is realized first and
 * the second fact is attached to the shared object as a relative clause,
 * e.g. X is located in Y, which is its canton.  The rule family is
 * deliberately restricted by the RELSEQ clauses below: it applies only
 * to predicates explicitly listed as safe possessive relational nouns.
 */
SENT -> SENT comma RELSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$PatRel, s:$S, p:$PRel, o:$O],
   ii:[pattern:$PatMain, s:$S, p:$PMain, o:$O]];

  attest $PRel != $PMain;

  ↓1 = [HEAD:webnlg_simple, pattern:$PatMain, s:$S, p:$PMain, o:$O];
  ↓2 = [];
  ↓3 = [HEAD:poss_rel_for, p:$PRel];

  ⇑ = ⇓3;
}

SENT -> SENT comma RELSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$PatMain, s:$S, p:$PMain, o:$O],
   ii:[pattern:$PatRel, s:$S, p:$PRel, o:$O]];

  attest $PRel != $PMain;

  ↓1 = [HEAD:webnlg_simple, pattern:$PatMain, s:$S, p:$PMain, o:$O];
  ↓2 = [];
  ↓3 = [HEAD:poss_rel_for, p:$PRel];

  ⇑ = ⇓3;
}

/* Same subject, different predicates: share the initial NP and coordinate VPs.
 * This covers generic patterns and a small set of predicate-frame VP fragments.
 * If a predicate has no VPSEQ rule, the independent fallback below remains.
 */
SENT -> NP VPSEQ _and_ VPSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$Pat1, s:$S, p:$P1, o:$O1],
   ii:[pattern:$Pat2, s:$S, p:$P2, o:$O2]];

  attest $P1 != $P2;
  /* Same-subject/same-object predicate pairs are handled by the
   * possessive-relative family above when licensed.  Do not also build
   * a flat VP coordination such as "X is located in Y and is in Y".
   */
  attest $O1 != $O2;

  ↓1 = $S;
  ↓2 = [pattern:$Pat1, p:$P1, o:$O1];
  ↓3 = [];
  ↓4 = [pattern:$Pat2, p:$P2, o:$O2];

  ⇑ = ⇓4;
}

/* Same subject and predicate, different objects: coordinate two VP fragments.
 * This is useful for list-like RDF duplicates where objects differ.
 */
SENT -> NP VPSEQ _and_ VPSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$Pat1, s:$S, p:$P, o:$O1],
   ii:[pattern:$Pat2, s:$S, p:$P, o:$O2]];

  attest $O1 != $O2;

  ↓1 = $S;
  ↓2 = [pattern:$Pat1, p:$P, o:$O1];
  ↓3 = [];
  ↓4 = [pattern:$Pat2, p:$P, o:$O2];

  ⇑ = ⇓4;
}

/* Object of first triple is subject of second: simple relative attachment.
 * The first triple remains a full realization; the second is a relative
 * clause when its predicate can be expressed as a RELSEQ fragment.
 */
SENT -> SENT comma RELSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$Pat1, s:$S1, p:$P1, o:$M],
   ii:[pattern:$Pat2, s:$M, p:$P2, o:$O2]];

  ↓1 = [HEAD:webnlg_simple, pattern:$Pat1, s:$S1, p:$P1, o:$M];
  ↓2 = [];
  ↓3 = [pattern:$Pat2, p:$P2, o:$O2];

  ⇑ = ⇓3;
}

/* Subject of first triple is object of second: inverse relative attachment. */
SENT -> SENT comma RELSEQ {
  [HEAD:webnlg_sequence, size:2,
   i:[pattern:$Pat1, s:$M, p:$P1, o:$O1],
   ii:[pattern:$Pat2, s:$S2, p:$P2, o:$M]];

  ↓1 = [HEAD:webnlg_simple, pattern:$Pat2, s:$S2, p:$P2, o:$M];
  ↓2 = [];
  ↓3 = [pattern:$Pat1, p:$P1, o:$O1];

  ⇑ = ⇓3;
}


/************************************************************
 * v39: size-3 reduction before full realization.
 *
 * These rules reduce exact or partial duplicates structurally.  They keep the
 * compositional size-2 rules available after deduplication, rather than
 * directly concatenating three full sentences.  This is intended to cut the
 * main source of output explosion in 3-triple inputs.
 ************************************************************/

/* Three exact semantic duplicates: realize a single triple. */
SENT -> SENT {
  [HEAD:webnlg_sequence, size:3, i:$T1, ii:$T1, iii:$T1];

  ↓1 = [HEAD:webnlg_simple] U $T1;

  ⇑ = ⇓1;
}

/* First and second triples duplicate: reduce to a 2-triple sequence. */
SENT -> SENT {
  [HEAD:webnlg_sequence, size:3, i:$T1, ii:$T1, iii:$T3];

  attest $T1 != $T3;

  ↓1 = [HEAD:webnlg_sequence, size:2, i:$T1, ii:$T3];

  ⇑ = ⇓1;
}

/* First and third triples duplicate: reduce to a 2-triple sequence. */
SENT -> SENT {
  [HEAD:webnlg_sequence, size:3, i:$T1, ii:$T2, iii:$T1];

  attest $T1 != $T2;

  ↓1 = [HEAD:webnlg_sequence, size:2, i:$T1, ii:$T2];

  ⇑ = ⇓1;
}

/* Second and third triples duplicate: reduce to a 2-triple sequence. */
SENT -> SENT {
  [HEAD:webnlg_sequence, size:3, i:$T1, ii:$T2, iii:$T2];

  attest $T1 != $T2;

  ↓1 = [HEAD:webnlg_sequence, size:2, i:$T1, ii:$T2];

  ⇑ = ⇓1;
}

/* Same subject, three different predicates: one NP, coordinated VP fragments. */
SENT -> NP VPSEQ comma VPSEQ _and_ VPSEQ {
  [HEAD:webnlg_sequence, size:3,
   i:[pattern:$Pat1, s:$S, p:$P1, o:$O1],
   ii:[pattern:$Pat2, s:$S, p:$P2, o:$O2],
   iii:[pattern:$Pat3, s:$S, p:$P3, o:$O3]];

  attest $P1 != $P2;
  attest $P1 != $P3;
  attest $P2 != $P3;

  ↓1 = $S;
  ↓2 = [pattern:$Pat1, p:$P1, o:$O1];
  ↓3 = [];
  ↓4 = [pattern:$Pat2, p:$P2, o:$O2];
  ↓5 = [];
  ↓6 = [pattern:$Pat3, p:$P3, o:$O3];

  ⇑ = ⇓6;
}

/* Same subject and predicate, three different objects: one NP, three VP fragments.
 * A later version can replace this by object-list coordination for selected
 * list-like predicates; this rule is deliberately structural and conservative.
 */
SENT -> NP VPSEQ comma VPSEQ _and_ VPSEQ {
  [HEAD:webnlg_sequence, size:3,
   i:[pattern:$Pat1, s:$S, p:$P, o:$O1],
   ii:[pattern:$Pat2, s:$S, p:$P, o:$O2],
   iii:[pattern:$Pat3, s:$S, p:$P, o:$O3]];

  attest $O1 != $O2;
  attest $O1 != $O3;
  attest $O2 != $O3;

  ↓1 = $S;
  ↓2 = [pattern:$Pat1, p:$P, o:$O1];
  ↓3 = [];
  ↓4 = [pattern:$Pat2, p:$P, o:$O2];
  ↓5 = [];
  ↓6 = [pattern:$Pat3, p:$P, o:$O3];

  ⇑ = ⇓6;
}

/************************************************************
 * VP fragments used by same-subject coordination.
 ************************************************************/

VPSEQ -> VREL NP {
  [pattern:svo, p:$P, o:$O];
  ↓1 = $P;
  ↓2 = $O;
  ⇑ = ⇓1;
}

VPSEQ -> cop ADJ {
  [pattern:cop_adj, p:$P, o:$O];
  ↓1 = [@present, @indicative, @_3s];
  ↓2 = $P U $O;
  ⇑ = ⇓2;
}

VPSEQ -> cop NP {
  [pattern:cop_nom, p:$P, o:$O];
  ↓1 = [@present, @indicative, @_3s];
  ↓2 = $O;
  ⇑ = ⇓2;
}

/* Frequent frame predicates expressed without repeating the subject. */
VPSEQ -> cop _located_ prep NP {
  [pattern:frame, p:[HEAD:location], o:$O];
  ↓1 = [@present, @indicative, @_3s];
  ↓2 = [];
  ↓3 = [pcas:in];
  ↓4 = $O;
  ⇑ = ⇓4;
}

