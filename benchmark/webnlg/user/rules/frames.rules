// elevationM(X,Y) -> X has an elevation of Y metres above sea level.
SENT -> NP _has_ det common_noun prep NUMBER_METRES _above_ _sea_level_ {
  [HEAD:elevation_M, i:$I, ii:$II];
  ↓1 = $I;
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = [@indef, @s, before_vowel:true];
  ↓4 = [HEAD:_ELEVATION, @s];
  ↓5 = [pcas:of];
  ↓6 = $II;
  ↓7 = [];
  ↓8 = [];
  ⇑ = ⇓8;
}

