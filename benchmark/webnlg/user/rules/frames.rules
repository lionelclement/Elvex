/************************************************************
 * Predicate-specific frames.
 *
 * General policy:
 * - If a WebNLG predicate maps directly to a verbal relation, the generic
 *   SVO rules in simple_triples.rules are enough.
 * - If the predicate does not map naturally to an immediate verb frame,
 *   write an explicit frame here and add the needed lexical resources in
 *   user/override.pattern and user/override.morpho.
 ************************************************************/

// leaderName(X,Y) -> The leader of X is Y.
// Example: The leader of Aarhus is Jacob Bundsgaard.
SENT -> NP cop NP {
  [HEAD:leader_Name, i:$I, ii:$II];
  ↓1 = [HEAD:_LEADER, @def, @s, dem:false, poss:false, part:false, ofObj:$I];
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = $II;
  ⇑ = ⇓3;
}

// leaderName(X,Y) -> Y is the leader of X.
// This paraphrase is valid but may score differently from the WebNLG reference.
SENT -> NP cop NP {
  [HEAD:leader_Name, i:$I, ii:$II];
  ↓1 = $II;
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = [HEAD:_LEADER, @def, @s, dem:false, poss:false, part:false, ofObj:$I];
  ⇑ = ⇓3;
}

// runwayLength(X,Y) -> The runway length at X is Y meters.
// Example: The runway length at Aarhus Airport is 2777.0 meters.
SENT -> NP cop NUMBER_METERS {
  [HEAD:runway_Length, i:$I, ii:$II];
  ↓1 = [HEAD:_RUNWAY_LENGTH, @def, @s, dem:false, poss:false, part:false, atObj:$I];
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = $II;
  ⇑ = ⇓3;
}

// location(X,Y) -> X is located in Y.
