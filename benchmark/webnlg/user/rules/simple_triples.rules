/************************************************************
 * Generic WebNLG rules.
 *
 * Two kinds of simple-triple inputs are accepted:
 *
 * 1. Generic fallback input, generated when there is no explicit frame:
 *    S [HEAD:webnlg_simple, pattern:svo|cop_adj|cop_nom|rel_nom,
 *       s:[HEAD:...], p:[HEAD:...], o:[HEAD:...]]
 *
 * 2. Predicate-frame input, generated when user/rules/frames.rules contains
 *    a dedicated frame for the predicate:
 *    S [HEAD:leader_Name, i:[HEAD:Aarhus], ii:[HEAD:Jacob_Bundsgaard]]
 ************************************************************/

S -> SENT dot {
  [HEAD:webnlg_simple];
  ↓1 = ↑;
  ↓2 = [];
  ⇑ = ⇓1;
}


// Predicate-specific frame dispatch, used when generated inputs encode a
// triple as [HEAD:webnlg_simple, pattern:frame, s:..., p:[HEAD:P], o:...].
// The child SENT receives the frame-specific inherited structure expected by
// user/rules/frames.rules.
SENT -> SENT {
  [HEAD:webnlg_simple, pattern:frame, s:$S, p:[HEAD:$P], o:$O];

  ↓1 = [HEAD:$P, i:$S, ii:$O];

  ⇑ = ⇓1;
}

SENT -> NP VP {
  [HEAD:webnlg_simple, pattern:svo, s:$S, p:$P, o:$O];
  ↓1 = $S;
  ↓2 = [p:$P, o:$O];
  ⇑ = ⇓2;
}

SENT -> NP cop ADJ {
  [HEAD:webnlg_simple, pattern:cop_adj, s:$S, p:$P, o:$O];
  ↓1 = $S;
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = $P U $O;
  ⇑ = ⇓3;
}

SENT -> NP cop NP {
  [HEAD:webnlg_simple, pattern:cop_nom, s:$S, p:$P, o:$O];
  ↓1 = $S;
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = $O;
  ⇑ = ⇓3;
}

// Generic nominal relation fallback, subject first:
//   The relation-noun of X is Y.
// Prefer explicit frames in user/rules/frames.rules for scoring-sensitive cases.
SENT -> NP cop NP {
  [HEAD:webnlg_simple, pattern:rel_nom, s:$S, p:$P, o:$O];
  ↓1 = [rel:$P, obj:$S, @def, dem:false, poss:false, part:false];
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = $O;
  ⇑ = ⇓3;
}

// Generic nominal relation fallback, value first:
//   Y is the relation-noun of X.
SENT -> NP cop NP {
  [HEAD:webnlg_simple, pattern:rel_nom, s:$S, p:$P, o:$O];
  ↓1 = $O;
  ↓2 = [@present, @indicative, @_3s];
  ↓3 = [rel:$P, obj:$S, @def, dem:false, poss:false, part:false];
  ⇑ = ⇓3;
}

VP -> VREL NP {
  [p:$P, o:$O];
  ↓1 = $P;
  ↓2 = $O;
  ⇑ = ⇓1;
}

// Noun phrases.
// Determiner selection is constrained by unification: if the inherited NP
// contains [def:true], then only determiners whose lexical entry also
// unifies with [def:true] can be selected.
NP -> det N {
  ↓1 = ↑ U ⇓2;
  ↓2 = ↑;
  ⇑ = ⇓2 U [@_3];
}

NP -> proper_noun {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

NP -> pro {
  ↓1 = ↑;
  ⇑ = ⇓1;
}


// Numeric expressions can occur as objects in WebNLG triples. They are
// generated by variable local lexicon entries rather than compacted as
// proper nouns.
NP -> NUMBER {
  [value:$Value];
  ↓1 = ↑;
  ⇑ = ⇓1;
}

NP -> NUMBER_UNIT {
  [value:$Value, unit:$Unit];
  ↓1 = ↑;
  ⇑ = ⇓1;
}

// Common noun without complement.
// If an ofObj complement is requested, the N -> N PP rule below must be used.
N -> common_noun {
  [ofObj:NIL, atObj:NIL];
  ↓1 = ↑;
  ⇑ = ⇓1;
}

// Generic noun fallback, kept for compatibility with generated resources.
N -> noun {
  [ofObj:NIL, atObj:NIL];
  ↓1 = ↑;
  ⇑ = ⇓1;
}

// Common-noun phrase with a prepositional complement, e.g. "leader of X".
// The complement feature is removed before passing inheritance to the
// lexical noun, which avoids recursive reuse of the same ofObj constraint.
N -> N PP {
  [ofObj:$I, $Rest];
  ↓1 = $Rest;
  ↓2 = [pcas:of, obj:$I];
  ⇑ = ⇓1;
}

N -> N PP {
  [atObj:$I, $Rest];
  ↓1 = $Rest;
  ↓2 = [pcas:at, obj:$I];
  ⇑ = ⇓1;
}

PP -> prep NP {
  [pcas:$Pcas, obj:$I];
  ↓1 = [pcas:$Pcas];
  ↓2 = $I;
  ⇑ = ⇓2;
}

VREL -> vrel {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

NREL -> nrel {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

PREP -> prep {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

ADJ -> adj {
  ↓1 = ↑;
  ⇑ = ⇓1;
}


VALUE -> value {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

// Generic argument: an entity NP, a literal value, or a numeric expression.
// This is useful for frames whose object may be either an RDF resource
// (proper_noun/NP) or an RDF literal (VALUE).
ARG -> NP {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

ARG -> VALUE {
  ↓1 = ↑;
  ⇑ = ⇓1;
}
