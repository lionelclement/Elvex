/************************************************************
 * Base local lexicon.
 * Closed-class and functional entries only: no HEAD here.
 * Fields are separated by tabs: output-form POS features;
 ************************************************************/
"."    dot    [];
","    comma  [];

"is"     cop    [@present, @indicative, @_3s];
"are"    cop    [@present, @indicative, @_3p];

// Determiners.
// Determiners distinguish definiteness from true indefiniteness.
// def:false alone is broad: possessives, demonstratives and quantifiers may
// be non-definite without being valid realizations for an indefinite NP.
// Frames that need a real indefinite article should request @indef, not only
// def:false.
"a"      det    [@s, @indef];
""       det    [@p, @indef];
"the"    det    [def:true, poss:false, part:false, dem:false];

"my"     det    [@s, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_1s]];
"your"   det    [@s, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_2s]];
"our"    det    [@p, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_1p]];
"their"  det    [@p, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_3p]];
"his"    det    [@ms, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_3ms, human:true]];
"her"    det    [@fs, indef:false, def:false, poss:true, part:false, dem:false, owner:[@_3fs, human:true]];

"this"   det    [@s, def:true, poss:false, part:false, dem:true];
"that"   det    [@s, def:true, poss:false, part:false, dem:true];
"these"  det    [@p, def:true, poss:false, part:false, dem:true];
"those"  det    [@p, def:true, poss:false, part:false, dem:true];

"some"   det    [@p, indef:false, def:false, poss:false, part:false, dem:false, quant:some];
"several" det   [@p, indef:false, def:false, poss:false, part:false, dem:false, quant:several];
"many"   det    [@p, indef:false, def:false, poss:false, part:false, dem:false, quant:many];
"few"    det    [@p, indef:false, def:false, poss:false, part:false, dem:false, quant:few];
"each"   det    [@s, indef:false, def:false, poss:false, part:false, dem:false, quant:each];
"every"  det    [@s, indef:false, def:false, poss:false, part:false, dem:false, quant:every];

"of"     prep   [pcas:of];
"at"     prep   [pcas:at];
"in"     prep   [pcas:in];

// Dynamic literal values supplied by input features.
// General strings may still be realized through FORM.
FORM   value          [];
"located" _located_ [];

// Predicate-frame function words and phrases.
"operated" _operated_ [];
"by" _by_ [];
"has" _has_ [@present, @indicative, @_3s];
"above" _above_ [];
"sea level" _sea_level_ [];

// Metric spelling variants used by WebNLG references.
"$NUMBER metres"  NUMBER_METRES  [value:$NUMBER];

// Numeric values are not compacted as proper nouns. They are realized by
// variable lexical entries selected by [value:$NUMBER].
"$NUMBER"          NUMBER         [value:$NUMBER];
"$NUMBER $UNIT"    NUMBER_UNIT    [value:$NUMBER, unit:$UNIT];
"$NUMBER meters"   NUMBER_METERS  [value:$NUMBER];

// Additional predicate-frame function words.
"found" _found_ [];
