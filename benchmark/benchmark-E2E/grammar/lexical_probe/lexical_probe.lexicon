FORM form;

/* Collocational modifiers */
"heavy" ADJ [HEAD:HEAVY];
"torrential" ADJ [HEAD:TORRENTIAL];
"strong" ADJ [HEAD:STRONG];
"deep" ADJ [HEAD:DEEP];
"complete" ADJ [HEAD:COMPLETE];
"serious" ADJ [HEAD:SERIOUS];
"high" ADJ [HEAD:HIGH];
"good" ADJ [HEAD:GOOD];
"heated" ADJ [HEAD:HEATED];
"harsh" ADJ [HEAD:HARSH];
"sharp" ADJ [HEAD:SHARP];

/* Collocation bases */
"rain" N [HEAD:RAIN];
"wind" N [HEAD:WIND];
"coffee" N [HEAD:COFFEE];
"tea" N [HEAD:TEA];
"traffic" N [HEAD:TRAFFIC];
"smoker" N [HEAD:SMOKER];
"sleep" N [HEAD:SLEEP];
"silence" N [HEAD:SILENCE];
"mistake" N [HEAD:MISTAKE];
"problem" N [HEAD:PROBLEM];
"risk" N [HEAD:RISK];
"chance" N [HEAD:CHANCE];
"argument" N [HEAD:ARGUMENT];
"criticism" N [HEAD:CRITICISM];
"pain" N [HEAD:PAIN];

/* Support verbs, past tense */
"made" V_PAST [HEAD:MAKE, tense:past];
"paid" V_PAST [HEAD:PAY, tense:past];
"did" V_PAST [HEAD:DO, tense:past];

/* Predicative nouns as support-verb complements */
"a decision" NP_BARE_OR_DET [HEAD:DECISION, support:<[HEAD:MAKE]>];
"attention" NP_BARE_OR_DET [HEAD:ATTENTION, support:<[HEAD:PAY]>];
"an effort" NP_BARE_OR_DET [HEAD:EFFORT, support:<[HEAD:MAKE]>];
"an attempt" NP_BARE_OR_DET [HEAD:ATTEMPT, support:<[HEAD:MAKE]>];
"a choice" NP_BARE_OR_DET [HEAD:CHOICE, support:<[HEAD:MAKE]>];
"a claim" NP_BARE_OR_DET [HEAD:CLAIM, support:<[HEAD:MAKE]>];
"a promise" NP_BARE_OR_DET [HEAD:PROMISE, support:<[HEAD:MAKE]>];
"a mistake" NP_BARE_OR_DET [HEAD:MISTAKE, support:<[HEAD:MAKE]>];
"progress" NP_BARE_OR_DET [HEAD:PROGRESS, support:<[HEAD:MAKE]>];
"damage" NP_BARE_OR_DET [HEAD:DAMAGE, support:<[HEAD:DO]>];
"business" NP_BARE_OR_DET [HEAD:BUSINESS, support:<[HEAD:DO]>];
