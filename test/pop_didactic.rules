@withoutSpaces
LH_IV_PATTERN → LH_BASS_CHORD { [mode:minor] ⊂ ↑; ↓1=↑ ∪ [root:5,fifth:0,quality:min]; ⇑=[];}
@withoutSpaces
LH_IV_CHORDS → LH_CHORD4 { [mode:major] ⊂ ↑; ↓1=↑ ∪ [root:5,quality:maj]; ⇑=[];}
@withoutSpaces
