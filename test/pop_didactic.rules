@withoutSpaces
LH_VI_PATTERN → LH_BASS_CHORD { [mode:minor] ⊂ ↑; ↓1=↑ ∪ [root:8,fifth:3,quality:maj]; ⇑=[];}
@withoutSpaces
LH_I_FINAL → LH_HALF_CADENCE { [mode:major] ⊂ ↑; ↓1=↑ ∪ [root:0,quality:maj]; ⇑=[];}
@withoutSpaces
LH_I_FINAL → LH_HALF_CADENCE { [mode:minor] ⊂ ↑; ↓1=↑ ∪ [root:0,quality:min]; ⇑=[];}

