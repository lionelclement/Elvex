RH_REPLY_IV → BAR2 { ↓1=↑ ∪ [motif:[o1:5,o2:4], rhythm:[r1:"1/2",r2:"1/2"]]; ⇑=[];}
@withoutSpaces
RH_REPLY_VI → BAR4 { ↓1=↑ ∪ [motif:[o1:9,o2:7,o3:5,o4:4], rhythm:[r1:"1/4",r2:"1/4",r3:"1/4",r4:"1/4"]]; ⇑=[];}
@withoutSpaces
RH_PRECHORUS_ANSWER → BAR4 { ↓1=↑ ∪ [motif:[o1:5,o2:7,o3:9,o4:7], rhythm:[r1:"1/4",r2:"1/4",r3:"1/4",r4:"1/4"]]; ⇑=[];}
@withoutSpaces
RH_HOOK_ANSWER → BAR2 { ↓1=↑ ∪ [motif:[o1:12,o2:9], rhythm:[r1:"1/2",r2:"1/2"]]; ⇑=[];}
