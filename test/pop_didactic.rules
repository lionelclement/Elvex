// =============================================================================
// pop_didactic.rules — mini-grammaire pop/chanson simple, bornée et didactique
// =============================================================================
// Cette grammaire remplace les gros modules historiques par un chemin de
// génération court. Le but est d'éviter l'explosion observée :
//   *** fatal error: too much items build : 12001 (12000 Max)
//
// Principe musical
// ----------------
// Les règles décrivent des fonctions, pas des instruments :
//   lead / countermelody / guitar / piano_rh / piano_lh / keyboard_rh /
//   keyboard_lh / keyboard / pad / brass_punch / bass / drums / hand_drums.
//
// Pour piano et clavier, on distingue deux fonctions pédagogiques :
//   - *_lh : accompagnement harmonique de main gauche, principalement basse +
//            accord, avec quelques mesures d'accords plaqués pour respirer ;
//   - *_rh : réponse mélodique de main droite, c'est-à-dire de petits fragments
//            placés dans les espaces de la mélodie principale ou du chant.
//
// La forme pop_didactic_verse_chorus_16 vaut 16 mesures :
//   1-4   couplet A      I - V - vi - IV
//   5-8   couplet A'     I - V - IV - I
//   9-12  refrain B      vi - IV - I - V
//   13-16 cadence        IV - V - I - I
//
// En mineur, on conserve la même logique fonctionnelle mais avec :
//   i - V - VI - iv, puis iv - V - i.
//
// Les notes sont données comme degrés relatifs à tonic_pc. Les règles BAR*
// convertissent ensuite tonic_pc + offset en pc absolu modulo 12.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Racine LilyPond : header + score.
// -----------------------------------------------------------------------------

@withoutSpaces
PIECE → VERSION PAPER_NO_TAGLINE HEADER SCORE
{ ↓1=[]; ↓2=[]; ↓3=↑; ↓4=↑; ⇑=[]; }

@withoutSpaces
HEADER → HEADER_OPEN TITLE COMPOSER HEADER_CLOSE
{ [title:$title, composer:$composer] ⊂ ↑; ↓1=[]; ↓2=[title:$title]; ↓3=[composer:$composer]; ↓4=[]; ⇑=[]; }

// La tonique numérique tonic_pc est maintenant donnée directement dans les inputs.
// Cela évite une règle vide KEY_PROFILE qui bloquait la réduction dans Elvex.

// Scores bornés aux tailles d'ensemble présentes dans les exemples : 4, 6, 7, 9.
// IMPORTANT : tonic_pc est lu directement dans key. On évite ainsi un non-terminal
// vide intermédiaire pour calculer la tonique, qui rendait la dérivation fragile.

@withoutSpaces
SCORE → SCORE_OPEN PAR_OPEN STAFF1 STAFF2 STAFF3 STAFF4 PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [ensemble:[instruments:[count:4]], key:[tonic:$tonic, mode:$mode, tonic_pc:$t], notation:[accidental_policy:$a]] ⊂ ↑;
  $ctx = ↑ ∪ [tonic_pc:$t, key:[tonic:$tonic, mode:$mode, tonic_pc:$t], accidental_policy:$a];
  ↓1=[]; ↓2=[];
  ↓3=$ctx; ↓4=$ctx; ↓5=$ctx; ↓6=$ctx;
  ↓7=[]; ↓8=[]; ↓9=[]; ↓10=[];
  ⇑=[];
}

@withoutSpaces
SCORE → SCORE_OPEN PAR_OPEN STAFF1 STAFF2 STAFF3 STAFF4 STAFF5 STAFF6 PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [ensemble:[instruments:[count:6]], key:[tonic:$tonic, mode:$mode, tonic_pc:$t], notation:[accidental_policy:$a]] ⊂ ↑;
  $ctx = ↑ ∪ [tonic_pc:$t, key:[tonic:$tonic, mode:$mode, tonic_pc:$t], accidental_policy:$a];
  ↓1=[]; ↓2=[];
  ↓3=$ctx; ↓4=$ctx; ↓5=$ctx; ↓6=$ctx; ↓7=$ctx; ↓8=$ctx;
  ↓9=[]; ↓10=[]; ↓11=[]; ↓12=[];
  ⇑=[];
}

@withoutSpaces
SCORE → SCORE_OPEN PAR_OPEN STAFF1 STAFF2 STAFF3 STAFF4 STAFF5 STAFF6 STAFF7 PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [ensemble:[instruments:[count:7]], key:[tonic:$tonic, mode:$mode, tonic_pc:$t], notation:[accidental_policy:$a]] ⊂ ↑;
  $ctx = ↑ ∪ [tonic_pc:$t, key:[tonic:$tonic, mode:$mode, tonic_pc:$t], accidental_policy:$a];
  ↓1=[]; ↓2=[];
  ↓3=$ctx; ↓4=$ctx; ↓5=$ctx; ↓6=$ctx; ↓7=$ctx; ↓8=$ctx; ↓9=$ctx;
  ↓10=[]; ↓11=[]; ↓12=[]; ↓13=[];
  ⇑=[];
}

@withoutSpaces
SCORE → SCORE_OPEN PAR_OPEN STAFF1 STAFF2 STAFF3 STAFF4 STAFF5 STAFF6 STAFF7 STAFF8 STAFF9 PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [ensemble:[instruments:[count:9]], key:[tonic:$tonic, mode:$mode, tonic_pc:$t], notation:[accidental_policy:$a]] ⊂ ↑;
  $ctx = ↑ ∪ [tonic_pc:$t, key:[tonic:$tonic, mode:$mode, tonic_pc:$t], accidental_policy:$a];
  ↓1=[]; ↓2=[];
  ↓3=$ctx; ↓4=$ctx; ↓5=$ctx; ↓6=$ctx; ↓7=$ctx; ↓8=$ctx; ↓9=$ctx; ↓10=$ctx; ↓11=$ctx;
  ↓12=[]; ↓13=[]; ↓14=[]; ↓15=[];
  ⇑=[];
}

@withoutSpaces
SCORE → SCORE_OPEN PAR_OPEN STAFF1 STAFF2 STAFF3 STAFF4 STAFF5 STAFF6 STAFF7 STAFF8 STAFF9 STAFF10 PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [ensemble:[instruments:[count:10]], key:[tonic:$tonic, mode:$mode, tonic_pc:$t], notation:[accidental_policy:$a]] ⊂ ↑;
  $ctx = ↑ ∪ [tonic_pc:$t, key:[tonic:$tonic, mode:$mode, tonic_pc:$t], accidental_policy:$a];
  ↓1=[]; ↓2=[];
  ↓3=$ctx; ↓4=$ctx; ↓5=$ctx; ↓6=$ctx; ↓7=$ctx; ↓8=$ctx; ↓9=$ctx; ↓10=$ctx; ↓11=$ctx; ↓12=$ctx;
  ↓13=[]; ↓14=[]; ↓15=[]; ↓16=[];
  ⇑=[];
}

