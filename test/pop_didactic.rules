@withoutSpaces
RH_PAD_RESPONSE → BAR1 { ↓1=↑ ∪ [motif:[o1:7], rhythm:[r1:"1/1"]]; ⇑=[];}

// Main gauche piano/clavier : fonction harmonique.
// PATTERN = basse sur le temps fort, accord au milieu, quinte, accord.
// CHORDS  = accords plaqués réguliers, pour alléger l'effet basse obstinée.
@withoutSpaces
LH_I_PATTERN → LH_BASS_CHORD { [mode:major] ⊂ ↑; ↓1=↑ ∪ [root:0,fifth:7,quality:maj]; ⇑=[];}
@withoutSpaces
LH_I_PATTERN → LH_BASS_CHORD { [mode:minor] ⊂ ↑; ↓1=↑ ∪ [root:0,fifth:7,quality:min]; ⇑=[];}
