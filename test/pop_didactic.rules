// -----------------------------------------------------------------------------
// 6. Barres de bas niveau : conversion degrés -> notes LilyPond.
// -----------------------------------------------------------------------------

@withoutSpaces
REST_BAR → REST BARLINE { ↓1=[dur:"1/1"]; ↓2=[]; ⇑=[];}

@withoutSpaces
BAR1 → NOTE BARLINE
{ [tonic_pc:$t, octave:$oct, accidental_policy:$a, motif:[o1:$o1], rhythm:[r1:$r1]] ⊂ ↑; $pc1=($t+$o1)%12; ↓1=[pc:$pc1,octave:$oct,dur:$r1,accidental_policy:$a]; ↓2=[]; }
@withoutSpaces
BAR2 → NOTE NOTE BARLINE
{ [tonic_pc:$t, octave:$oct, accidental_policy:$a, motif:[o1:$o1,o2:$o2], rhythm:[r1:$r1,r2:$r2]] ⊂ ↑; $pc1=($t+$o1)%12; $pc2=($t+$o2)%12; ↓1=[pc:$pc1,octave:$oct,dur:$r1,accidental_policy:$a]; ↓2=[pc:$pc2,octave:$oct,dur:$r2,accidental_policy:$a]; ↓3=[]; }
@withoutSpaces
BAR4 → NOTE NOTE NOTE NOTE BARLINE
{ [tonic_pc:$t, octave:$oct, accidental_policy:$a, motif:[o1:$o1,o2:$o2,o3:$o3,o4:$o4], rhythm:[r1:$r1,r2:$r2,r3:$r3,r4:$r4]] ⊂ ↑; $pc1=($t+$o1)%12; $pc2=($t+$o2)%12; $pc3=($t+$o3)%12; $pc4=($t+$o4)%12; ↓1=[pc:$pc1,octave:$oct,dur:$r1,accidental_policy:$a]; ↓2=[pc:$pc2,octave:$oct,dur:$r2,accidental_policy:$a]; ↓3=[pc:$pc3,octave:$oct,dur:$r3,accidental_policy:$a]; ↓4=[pc:$pc4,octave:$oct,dur:$r4,accidental_policy:$a]; ↓5=[]; }
@withoutSpaces
BAR8 → NOTE NOTE NOTE NOTE NOTE NOTE NOTE NOTE BARLINE
{ [tonic_pc:$t, octave:$oct, accidental_policy:$a, motif:[o1:$o1,o2:$o2,o3:$o3,o4:$o4,o5:$o5,o6:$o6,o7:$o7,o8:$o8], rhythm:[r1:$r1,r2:$r2,r3:$r3,r4:$r4,r5:$r5,r6:$r6,r7:$r7,r8:$r8]] ⊂ ↑; $pc1=($t+$o1)%12; $pc2=($t+$o2)%12; $pc3=($t+$o3)%12; $pc4=($t+$o4)%12; $pc5=($t+$o5)%12; $pc6=($t+$o6)%12; $pc7=($t+$o7)%12; $pc8=($t+$o8)%12; ↓1=[pc:$pc1,octave:$oct,dur:$r1,accidental_policy:$a]; ↓2=[pc:$pc2,octave:$oct,dur:$r2,accidental_policy:$a]; ↓3=[pc:$pc3,octave:$oct,dur:$r3,accidental_policy:$a]; ↓4=[pc:$pc4,octave:$oct,dur:$r4,accidental_policy:$a]; ↓5=[pc:$pc5,octave:$oct,dur:$r5,accidental_policy:$a]; ↓6=[pc:$pc6,octave:$oct,dur:$r6,accidental_policy:$a]; ↓7=[pc:$pc7,octave:$oct,dur:$r7,accidental_policy:$a]; ↓8=[pc:$pc8,octave:$oct,dur:$r8,accidental_policy:$a]; ↓9=[]; }

@withoutSpaces
LH_BASS_CHORD → NOTE CHORD NOTE CHORD BARLINE
{
  [tonic_pc:$t, octave:$oct, accidental_policy:$a, root:$root, fifth:$fifth, quality:$q] ⊂ ↑;
  $pcRoot=($t+$root)%12;
  $pcFifth=($t+$fifth)%12;
  $chOct=$oct+1;
  ↓1=[pc:$pcRoot,octave:$oct,dur:"1/4",accidental_policy:$a];
  ↓2=[root_pc:$pcRoot,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓3=[pc:$pcFifth,octave:$oct,dur:"1/4",accidental_policy:$a];
  ↓4=[root_pc:$pcRoot,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓5=[];
  ⇑=[];
}

@withoutSpaces
LH_HALF_CADENCE → NOTE CHORD BARLINE
{
  [tonic_pc:$t, octave:$oct, accidental_policy:$a, root:$root, quality:$q] ⊂ ↑;
  $pcRoot=($t+$root)%12;
  $chOct=$oct+1;
  ↓1=[pc:$pcRoot,octave:$oct,dur:"1/2",accidental_policy:$a];
  ↓2=[root_pc:$pcRoot,octave:$chOct,dur:"1/2",quality:$q,accidental_policy:$a];
  ↓3=[];
  ⇑=[];
}


// Accords de main gauche.
// Les entrées CHORD du lexique commencent à l'octave 3.
// Les parties piano_lh/keyboard_lh peuvent être écrites à l'octave 2 pour les basses ;
// on place donc les accords une octave au-dessus, comme LH_BASS_CHORD et LH_HALF_CADENCE.
@withoutSpaces
LH_CHORD4 → CHORD CHORD CHORD CHORD BARLINE
{
  [tonic_pc:$t, octave:$oct, accidental_policy:$a, root:$root, quality:$q] ⊂ ↑;
  $pc=($t+$root)%12;
  $chOct=$oct+1;
  ↓1=[root_pc:$pc,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓2=[root_pc:$pc,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓3=[root_pc:$pc,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓4=[root_pc:$pc,octave:$chOct,dur:"1/4",quality:$q,accidental_policy:$a];
  ↓5=[];
  ⇑=[];
}

@withoutSpaces
