RH_HOOK_LIFT → BAR4 { ↓1=↑ ∪ [motif:[o1:7,o2:9,o3:11,o4:12], rhythm:[r1:"1/4",r2:"1/4",r3:"1/4",r4:"1/4"]]; ⇑=[];}
