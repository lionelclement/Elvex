@withoutSpaces
ACC_RH_MINUET_DOMINANT → CHORD_BAR3
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:7, q1:maj, root2:7, q2:maj, root3:7, q3:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
ACC_RH_MINUET_CADENCE → CHORD_BAR3
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:7, q1:maj, root2:7, q2:maj, root3:0, q3:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
ACC_RH_MINUET_CADENCE → CHORD_BAR3
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:7, q1:maj, root2:7, q2:maj, root3:0, q3:min], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
ACC_RH_MINUET_FINAL → CHORD_BAR3
