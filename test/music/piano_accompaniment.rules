ACC_LH_MINUET_DOMINANT → BAR3
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7, o2:14, o3:11], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

