@withoutSpaces
CH_GTR_ARP_SEVENTH → BAR4
{ ↓1=↑ ∪ [motif:[o1:10, o2:14, o3:17, o4:22], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CH_GTR_ARP_RELMAJ → BAR4
{ ↓1=↑ ∪ [motif:[o1:3, o2:10, o3:15, o4:19], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CH_GTR_ARP_SUBMED → BAR4
{ ↓1=↑ ∪ [motif:[o1:8, o2:15, o3:20, o4:24], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }

