// Arpèges à quatre événements. Chaque événement est une noire pour garder la routage robuste.
@withoutSpaces
CH_GTR_ARP_TONIC → BAR4
{ ↓1=↑ ∪ [motif:[o1:0, o2:7, o3:12, o4:15], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CH_GTR_ARP_DOMINANT → BAR4
{ ↓1=↑ ∪ [motif:[o1:7, o2:14, o3:19, o4:23], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
