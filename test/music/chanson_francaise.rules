CH_VOICE_INTRO_TURN → BAR4
{ ↓1=↑ ∪ [motif:[o1:14, o2:12, o3:10, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
