SAFE_RH_IV → CHORD_BAR4
{ ↓1=↑ ∪ [chords:[root1:5, q1:maj, root2:9, q2:min, root3:5, q3:maj, root4:9, q4:min], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
