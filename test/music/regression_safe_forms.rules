@withoutSpaces
SAFE_RH_I → CHORD_BAR4
{ ↓1=↑ ∪ [chords:[root1:0, q1:maj, root2:4, q2:min, root3:7, q3:maj, root4:0, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
