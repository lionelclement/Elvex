SAFE_FLUTE_BAR_TURN → BAR4
{ ↓1=↑ ∪ [motif:[o1:7, o2:9, o3:7, o4:5], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]]; ⇑=⇓1; }
