// =============================================================================
// regression_safe_forms.rules
// =============================================================================
// Formes de secours et routes stables conservées pour éviter les régressions. Ce module contient des combinaisons connues pour produire du LilyPond valide.
//


// -----------------------------------------------------------------------------
// Dispatches qui doivent apparaître avant long_forms/formal_long_forms dans music.rules.
// Ils contournent les chaînes fragiles last_offset -> opening_offset qui peuvent produire `_`.
// -----------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// Dispatches sûrs, exacts et prioritaires pour les fichiers générés 200/201 qui échouaient.
// Ils évitent qu’Elvex choisisse les anciennes règles formal_long_*, dont le last_offset synthétisé
// peut rester anonyme et causer ensuite des expressions comme 7 + _.
// Ils sont volontairement plus spécifiques que les anciens dispatches sûrs génériques :
// rôle exact, forme exacte, mesure et topic rythmique exacts.
// -----------------------------------------------------------------------------
@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_LEAD_32
{ [role:flute_piano_lead, form:formal_long_rounded_binary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_RH_VARIATIONS_32
{ [role:piano_acc_rh, form:formal_long_rounded_binary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_LH_VARIATIONS_32
{ [role:piano_acc_lh, form:formal_long_rounded_binary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_LEAD_32
{ [role:flute1, form:formal_long_ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_SUPPORT_32
{ [role:flute2, form:formal_long_ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_LEAD_32
{ [role:flute1|flute_piano_lead, form:long_ternary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_SUPPORT_32
{ [role:flute2, form:long_ternary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_LEAD_32
{ [role:flute1|flute_piano_lead, form:formal_long_ternary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_SUPPORT_32
{ [role:flute2, form:formal_long_ternary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
MUSICAL_FORM → SAFE_FLUTE_LONG_TERNARY_LEAD_32
{ [role:flute_piano_lead, form:formal_long_rounded_binary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_RH_VARIATIONS_32
{ [role:piano_acc_rh, form:formal_long_rounded_binary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_LH_VARIATIONS_32
{ [role:piano_acc_lh, form:formal_long_rounded_binary]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_RH_VARIATIONS_32
{ [role:piano_rh, form:formal_long_theme_and_variations]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
MUSICAL_FORM → SAFE_PIANO_LH_VARIATIONS_32
{ [role:piano_lh, form:formal_long_theme_and_variations]; [num:$num, den:$den] ⊂ ↑; ↓1=↑; ⇑=⇓1; }


// -----------------------------------------------------------------------------
// Matériau de secours anti-régression pour d’anciens fichiers générés vides.
//
// Objectif :
// Garde 101/201/202 non vides sans dépendre de chaînes fragiles comme
// last_offset -> opening_offset. Chaque mesure reçoit explicitement tonic_pc,
// octave et accidental_policy depuis le contexte de portée, afin qu’aucun `_` anonyme
// n’atteigne les calculs de BAR4 / CHORD_BAR4.
// -----------------------------------------------------------------------------

@withoutSpaces
SAFE_FLUTE_LONG_TERNARY_LEAD_32 → SAFE_FLUTE_LEAD_A_8 SAFE_FLUTE_LEAD_B_8 SAFE_FLUTE_LEAD_A_PRIME_8 SAFE_FLUTE_LEAD_CODA_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[bars:32, safe:true]; }

@withoutSpaces
SAFE_FLUTE_LONG_TERNARY_SUPPORT_32 → SAFE_FLUTE_SUPPORT_A_8 SAFE_FLUTE_SUPPORT_B_8 SAFE_FLUTE_SUPPORT_A_PRIME_8 SAFE_FLUTE_SUPPORT_CODA_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[bars:32, safe:true]; }

SAFE_FLUTE_LEAD_A_8 → SAFE_FLUTE_BAR_UP SAFE_FLUTE_BAR_TURN SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_CLOSE SAFE_FLUTE_BAR_UP SAFE_FLUTE_BAR_SEQ SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:a]; }
SAFE_FLUTE_LEAD_B_8 → SAFE_FLUTE_BAR_HIGH SAFE_FLUTE_BAR_SEQ SAFE_FLUTE_BAR_HIGH2 SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_STEPDOWN SAFE_FLUTE_BAR_TURN SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_CLOSE
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:b]; }
SAFE_FLUTE_LEAD_A_PRIME_8 → SAFE_FLUTE_BAR_UP SAFE_FLUTE_BAR_TURN2 SAFE_FLUTE_BAR_SEQ SAFE_FLUTE_BAR_CLOSE SAFE_FLUTE_BAR_HIGH SAFE_FLUTE_BAR_STEPDOWN SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:a_prime]; }
SAFE_FLUTE_LEAD_CODA_8 → SAFE_FLUTE_BAR_SEQ SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_HIGH2 SAFE_FLUTE_BAR_CLOSE SAFE_FLUTE_BAR_STEPDOWN SAFE_FLUTE_BAR_DOM SAFE_FLUTE_BAR_CLOSE SAFE_FLUTE_BAR_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:coda]; }

SAFE_FLUTE_SUPPORT_A_8 → SAFE_FLUTE_SUP_TONIC SAFE_FLUTE_SUP_THIRD SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_TONIC SAFE_FLUTE_SUP_LOW SAFE_FLUTE_SUP_THIRD SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:a_support]; }
SAFE_FLUTE_SUPPORT_B_8 → SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_STEP SAFE_FLUTE_SUP_HIGH SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_LOW SAFE_FLUTE_SUP_STEP SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_TONIC
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:b_support]; }
SAFE_FLUTE_SUPPORT_A_PRIME_8 → SAFE_FLUTE_SUP_TONIC SAFE_FLUTE_SUP_STEP SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_TONIC SAFE_FLUTE_SUP_LOW SAFE_FLUTE_SUP_THIRD SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:a_prime_support]; }
SAFE_FLUTE_SUPPORT_CODA_8 → SAFE_FLUTE_SUP_STEP SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_HIGH SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_LOW SAFE_FLUTE_SUP_DOM SAFE_FLUTE_SUP_TONIC SAFE_FLUTE_SUP_FINAL
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[section:coda_support]; }

@withoutSpaces
SAFE_FLUTE_BAR_UP → BAR4
{ ↓1=↑ ∪ [motif:[o1:0, o2:2, o3:4, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
