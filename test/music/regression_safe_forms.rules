@withoutSpaces
SAFE_FLUTE_SUP_STEP → BAR4
{ ↓1=↑ ∪ [motif:[o1:2, o2:4, o3:5, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
SAFE_FLUTE_SUP_HIGH → BAR2
{ ↓1=↑ ∪ [motif:[o1:9, o2:7], rhythm:[r1:"1/2", r2:"1/2"]]; ⇑=⇓1; }
