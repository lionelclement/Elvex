// -----------------------------------------------------------------------------
// Chœur : surtout des silences dans les couplets, des nappes et hooks de soutien dans les refrains.
// -----------------------------------------------------------------------------
ROCK_CHOIR_INTRO_4 → ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_REST
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[last_function:tonic]; }
ROCK_CHOIR_VERSE1_12 → ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_PAD_SOFT ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_PAD_DOM ROCK_CHOIR_REST ROCK_CHOIR_REST ROCK_CHOIR_PAD_SOFT ROCK_CHOIR_PAD_DOM
