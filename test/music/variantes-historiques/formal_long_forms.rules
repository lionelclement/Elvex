// -----------------------------------------------------------------------------
// Formal long-form architectures.
//
// This module avoids building long pieces by simple repetition.  It introduces
// section functions (intro, theme, variation, transition, contrast,
// development, recap, coda) and uses synthesized attributes to pass information
// from one section to the next.
//
// Explicit form values:
//   formal_long_rounded_binary
//   formal_long_ternary
//   formal_long_theme_and_variations
//   formal_long_siciliana
//   formal_long_gigue
//   formal_long_march
//
// Design pattern:
//   - macro-form is almost deterministic;
//   - local cells still contain limited variation;
//   - melodic secondary voices rest in some sections;
//   - bass/accompaniment/percussion remain comparatively continuous;
//   - synthesized attributes such as last_offset, section_role, theme_end,
//     contrast_end are propagated to later sections.
// -----------------------------------------------------------------------------

// --- Flute / flute+piano lead: formal rounded binary -------------------------

@withoutSpaces
MUSICAL_FORM → FORMAL_LONG_FLUTE_LEAD_ROUNDED
{ [role:flute1|flute_piano_lead, form:formal_long_rounded_binary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
FORMAL_LONG_FLUTE_LEAD_ROUNDED → FORMAL_LEAD_INTRO_4 FORMAL_LEAD_THEME_A_8 FORMAL_LEAD_A_VARIANT_8 FORMAL_LEAD_TRANSITION_4 FORMAL_LEAD_CONTRAST_B_8 FORMAL_LEAD_DEVELOPMENT_8 FORMAL_LEAD_RECAP_A_8 FORMAL_LEAD_CODA_4
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:intro];
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:theme];
  [last_offset:$theme_end] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:variation, opening_offset:$theme_end];
  [last_offset:$var_end] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:transition, opening_offset:$var_end];
  [last_offset:$transition_end] ⊂ ⇓4;
  ↓5 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:contrast, opening_offset:$transition_end];
  [last_offset:$contrast_end] ⊂ ⇓5;
  ↓6 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:development, opening_offset:$contrast_end, theme_reference:$theme_end];
  [last_offset:$dev_end] ⊂ ⇓6;
  ↓7 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:recap, opening_offset:$theme_end, previous_offset:$dev_end];
  [last_function:$recap_function] ⊂ ⇓7;
  ↓8 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, section_role:coda, previous_function:$recap_function, theme_reference:$theme_end];
  ⇑ = [form:formal_long_rounded_binary, bars:52, theme_end:$theme_end, contrast_end:$contrast_end, recap_function:$recap_function];
}

FORMAL_LEAD_INTRO_4 → REST_4_4_4
{ ↓1=↑; ⇑=[section_role:intro, last_offset:0, texture:breath_before_theme]; }

FORMAL_LEAD_THEME_A_8 → FLUTE_PIANO_LEAD_EIGHT_BAR
{ ↓1=↑; [last_offset:$m] ⊂ ⇓1; ⇑=[section_role:theme, last_offset:$m, theme_material:a]; }

FORMAL_LEAD_A_VARIANT_8 → FLP_A_PERIOD FLP_VARIATION FL1_FINAL_RESOLUTION
{ ↓1=↑; ↓2=↑; ↓3=↑; [last_offset:$m] ⊂ ⇓3; ⇑=[section_role:variation, last_offset:$m, variation:ornamented]; }

FORMAL_LEAD_TRANSITION_4 → FL1_MODULATING_MOTIF FL1_SEQUENCE_MOTIF FL1_DOMINANT_PREP FL1_AUTHENTIC_CADENCE
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; [last_offset:$m] ⊂ ⇓4; ⇑=[section_role:transition, last_offset:$m, harmonic_function:dominant_prep]; }

FORMAL_LEAD_CONTRAST_B_8 → FLP_CONTRAST_PERIOD FL1_SEQUENCE_MOTIF FL1_DOMINANT_KEY_MOTIF FL1_DOMINANT_KEY_CADENCE FL1_RETURN_MOTIF FL1_AUTHENTIC_CADENCE
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; [last_offset:$m] ⊂ ⇓6; ⇑=[section_role:contrast, last_offset:$m, register:upper_middle]; }

FORMAL_LEAD_DEVELOPMENT_8 → FL1_SEQUENCE_MOTIF REST_BAR4 FL1_MODULATING_MOTIF REST_BAR4 FL1_DOMINANT_PREP FL1_SEQUENCE_MOTIF FL1_AUTHENTIC_CADENCE REST_BAR4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; [last_offset:$m] ⊂ ⇓7; ⇑=[section_role:development, last_offset:$m, texture:fragmented]; }

FORMAL_LEAD_RECAP_A_8 → FLUTE_PIANO_LEAD_EIGHT_BAR
{ ↓1=↑; [last_function:$f] ⊂ ⇓1; [last_offset:$m] ⊂ ⇓1; ⇑=[section_role:recap, last_offset:$m, last_function:$f, recalled:true]; }

FORMAL_LEAD_CODA_4 → FL1_DOMINANT_PREP FL1_FINAL_RESOLUTION REST_BAR4 REST_BAR4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; [last_function:$f] ⊂ ⇓2; ⇑=[section_role:coda, last_function:$f, texture:cadential_breath]; }

