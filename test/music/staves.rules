// =============================================================================
// staves.rules
// =============================================================================
// Construction des portées LilyPond et dispatch musical historique. Les règles STAFF_* fabriquent les blocs \new Staff / PianoStaff, puis STAFF_MUSIC appelle MUSICAL_FORM.
//
//

FLUTE1_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:flute_duet]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[flute1:[name:$name, midi:$midi, octave:$octave, dynamic:$dynamic]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [dynamic:$dynamic];
  ↓8 = [role:flute1, form:$form, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓9 = [];
}

@withoutSpaces
FLUTE2_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:flute_duet]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[flute2:[name:$name, midi:$midi, octave:$octave, dynamic:$dynamic]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [dynamic:$dynamic];
  ↓8 = [role:flute2, form:$form, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓9 = [];
}


// --- Enveloppes de portées génériques/spécialisées -------------------------
// Ces enveloppes routent les blocs d’entrée vers les rôles musicaux. Le matériau musical réel
// est sélectionné ensuite par MUSICAL_FORM à partir de role + form.

@withoutSpaces
FLUTE_SOLO_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:solo_flute]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[flute:[name:$name, midi:$midi, octave:$octave, dynamic:$dynamic]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [dynamic:$dynamic];
  ↓8 = [role:flute1, form:$form, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓9 = [];
}

@withoutSpaces
FLUTE_WITH_PIANO_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:flute_piano_duet]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[flute:[name:$name, midi:$midi, octave:$octave, dynamic:$dynamic]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [dynamic:$dynamic];
  ↓8 = [role:flute_piano_lead, form:$form, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓9 = [];
}

@withoutSpaces
PIANO_STAFF_GROUP → PIANO_OPEN PIANO_RH_STAFF PIANO_LH_STAFF PIANO_CLOSE
{
  ↓1 = [];
  ↓2 = ↑;
  ↓3 = ↑;
  ↓4 = [];
}


// PianoStaff utilisé seulement dans flute_piano_duet.
// Il route volontairement vers des rôles d’accompagnement au lieu des rôles de piano seul.
// Résultat : la flûte porte la mélodie ; le piano fournit soutien harmonique et basse.
@withoutSpaces
PIANO_ACCOMP_STAFF_GROUP → PIANO_OPEN PIANO_ACC_RH_STAFF PIANO_ACC_LH_STAFF PIANO_CLOSE
{
  ↓1 = [];
  ↓2 = ↑;
  ↓3 = ↑;
  ↓4 = [];
}

@withoutSpaces
PIANO_ACC_RH_STAFF → PIANO_RH_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME CLEF_TREBLE DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:flute_piano_duet]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[piano:[name:$name, midi:$midi, right_hand:[octave:$octave, dynamic:$dynamic]]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [];
  ↓8 = [dynamic:$dynamic];
  ↓9 = [role:piano_acc_rh, form:$form, mode:$mode, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓10 = [];
}

@withoutSpaces
PIANO_ACC_LH_STAFF → PIANO_LH_OPEN MIDI_INSTRUMENT KEY TIME CLEF_BASS DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:flute_piano_duet]];
  [music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[piano:[midi:$midi, left_hand:[octave:$octave, dynamic:$dynamic]]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [midi_instrument:$midi];
  ↓3 = [tonic:$tonic, mode:$mode];
  ↓4 = [num:$num, den:$den];
  ↓5 = [];
  ↓6 = [dynamic:$dynamic];
  ↓7 = [role:piano_acc_lh, form:$form, mode:$mode, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓8 = [];
}

