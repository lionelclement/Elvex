@withoutSpaces
PIANO_LH_STAFF → PIANO_LH_OPEN MIDI_INSTRUMENT KEY TIME CLEF_BASS DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic]];
  [music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[piano:[midi:$midi, left_hand:[octave:$octave, dynamic:$dynamic]]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [midi_instrument:$midi];
  ↓3 = [tonic:$tonic, mode:$mode];
  ↓4 = [num:$num, den:$den];
  ↓5 = [];
  ↓6 = [dynamic:$dynamic];
  ↓7 = [role:piano_lh, form:$form, mode:$mode, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓8 = [];
}

@withoutSpaces
// -----------------------------------------------------------------------------
// STAFF_MUSIC : point de jonction entre une portée LilyPond et le matériau.
// Tout ce qui précède ouvre/configure la portée ; MUSICAL_FORM insère les notes.
// -----------------------------------------------------------------------------
STAFF_MUSIC → MUSICAL_FORM FINAL_BARLINE NL
{ ↓1 = ↑; ↓2 = []; ↓3 = []; ⇑ = ⇓1; }


// Rôles de piano. Pour l’instant, le matériau de piano est volontairement implémenté pour
// rounded_binary seulement. Les autres formes restent disponibles pour les routages de flûte seule.
@withoutSpaces
MUSICAL_FORM → PIANO_RH_ROUNDED_BINARY
{ [role:piano_rh, form:rounded_binary, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_LH_ROUNDED_BINARY
{ [role:piano_lh, form:rounded_binary, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }


// Rôles d’accompagnement de piano utilisés seulement pour flute_piano_duet.
// Ils sont volontairement moins mélodiques que piano_solo : surtout nappes d’accords,
// figures d’Alberti/basse brisée, pédales et soutien cadentiel.
@withoutSpaces
MUSICAL_FORM → PIANO_ACC_RH_ROUNDED_BINARY
{ [role:piano_acc_rh, form:rounded_binary, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_LH_ROUNDED_BINARY
{ [role:piano_acc_lh, form:rounded_binary, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

// Voix principale de flûte utilisée dans flute_piano_duet.
// Utilise un plan dédié de 8 mesures, aligné avec la routage de piano fiable.
// Cela évite le routage de modulation de piano en 16 mesures qui empêchait Elvex de terminer.
@withoutSpaces
MUSICAL_FORM → FLUTE_PIANO_LEAD_EIGHT_BAR
{ [role:flute_piano_lead, form:rounded_binary, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }



// --- Dispatches de formes supplémentaires pour piano et flûte+piano ---------
// Ces routages débloquent form:ternary, form:theme_and_variations et
// form:minuet_trio pour piano_solo et flute_piano_duet.
// Les plans musicaux concrets se trouvent dans piano_solo.rules et
// piano_accompaniment.rules. Minuet/trio est volontairement gardé par 3/4.

@withoutSpaces
MUSICAL_FORM → PIANO_RH_TERNARY_CONTROLLED
{ [role:piano_rh, form:ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_LH_TERNARY_CONTROLLED
{ [role:piano_lh, form:ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_RH_THEME_AND_VARIATIONS_CONTROLLED
{ [role:piano_rh, form:theme_and_variations, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_LH_THEME_AND_VARIATIONS_CONTROLLED
{ [role:piano_lh, form:theme_and_variations, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_RH_MINUET_TRIO
{ [role:piano_rh, form:minuet_trio, num:3, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_LH_MINUET_TRIO
{ [role:piano_lh, form:minuet_trio, num:3, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_RH_TERNARY_CONTROLLED
{ [role:piano_acc_rh, form:ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_LH_TERNARY_CONTROLLED
{ [role:piano_acc_lh, form:ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_RH_THEME_AND_VARIATIONS_CONTROLLED
{ [role:piano_acc_rh, form:theme_and_variations, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_LH_THEME_AND_VARIATIONS_CONTROLLED
{ [role:piano_acc_lh, form:theme_and_variations, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_RH_MINUET_TRIO
{ [role:piano_acc_rh, form:minuet_trio, num:3, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → PIANO_ACC_LH_MINUET_TRIO
{ [role:piano_acc_lh, form:minuet_trio, num:3, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE_PIANO_LEAD_TERNARY_CONTROLLED
{ [role:flute_piano_lead, form:ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE_PIANO_LEAD_THEME_AND_VARIATIONS_CONTROLLED
{ [role:flute_piano_lead, form:theme_and_variations, num:4, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE_PIANO_LEAD_MINUET_TRIO
{ [role:flute_piano_lead, form:minuet_trio, num:3, den:4, rhythm:[topic:neutral]]; ↓1 = ↑; ⇑ = ⇓1; }

// Dispatch par rôle. Les deux voix partagent le même plan formel mais pas le même matériau.


// -----------------------------------------------------------------------------
// Enveloppes expérimentales d’ensemble fondées sur les familles.
// Elles gardent la mise en page de la partition fixe tout en transmettant les traits génériques role + family
// à MUSICAL_FORM. Cela évite de dupliquer des formes complètes par instrument.
// -----------------------------------------------------------------------------

@withoutSpaces
STRING_QUARTET_SCORE → VIOLIN1_STAFF VIOLIN2_STAFF VIOLA_STAFF CELLO_STAFF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; }

@withoutSpaces
WOODWIND_TRIO_SCORE → WOODWIND1_STAFF WOODWIND2_STAFF WOODWIND3_STAFF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; }

@withoutSpaces
BRASS_TRIO_SCORE → BRASS1_STAFF BRASS2_STAFF BRASS3_STAFF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; }

@withoutSpaces
PERCUSSION_ENSEMBLE_SCORE → PERCUSSION1_STAFF PERCUSSION2_STAFF PERCUSSION3_STAFF PERCUSSION4_STAFF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; }

@withoutSpaces
PERCUSSION_DUO_SCORE → PERCUSSION1_STAFF PERCUSSION2_STAFF
{ ↓1 = ↑; ↓2 = ↑; }

@withoutSpaces
MIXED_QUINTET_SCORE → MIXED_WOODWIND_STAFF MIXED_STRING_STAFF MIXED_BASS_STAFF MIXED_BRASS_STAFF MIXED_PERCUSSION_STAFF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑; }

@withoutSpaces
VIOLIN1_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME CLEF_TREBLE DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [music:[style:classical_19c, phrase_model:periodic], ensemble:[type:string_quartet]];
  [bpm:$bpm,
   music:[form:$form, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]],
   ensemble:[violin1:[name:$name, family:$family, midi:$midi, octave:$octave, dynamic:$dynamic]],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [];
  ↓8 = [dynamic:$dynamic];
  ↓9 = [role:lead, family:bowed_strings, form:$form, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
  ↓10 = [];
}

