  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [];
  ↓8 = [dynamic:$dynamic];
  ↓9 = [role:piano_rh, form:$form, mode:$mode, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:$num, den:$den, rhythm:[topic:$topic, dance:$dance, density:$density, anacrusis:$anacrusis, hemiola_at_cadence:$hemiola_at_cadence, ostinato:$ostinato, articulation:$articulation]];
