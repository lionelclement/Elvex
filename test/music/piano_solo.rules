LH_DOMINANT_PEDAL_EIGHTHS → BAR8
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7, o2:14, o3:7, o4:14, o5:7, o6:14, o7:11, o8:14], rhythm:[r1:"1/8", r2:"1/8", r3:"1/8", r4:"1/8", r5:"1/8", r6:"1/8", r7:"1/8", r8:"1/8"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
LH_TONIC_BASS_HALF → BAR2
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0, o2:0], rhythm:[r1:"1/2", r2:"1/2"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
