// =============================================================================
// piano_solo.rules
// =============================================================================
// Matériau pour piano seul. Sépare généralement main droite et main gauche avec les rôles piano_rh et piano_lh.
//

// --- Matériau main droite / main gauche de piano ---------------------------
// La partie de piano est divisée en deux rôles :
// piano_rh = main droite, écrite avec les terminaux CHORD
// piano_lh = main gauche, écrite avec les terminaux NOTE en patrons de clé de fa
// Le plan de phrase reflète le plan binaire arrondi de la flûte afin que les lignes flûte+piano
// stay aligned bar-for-bar.

@withoutSpaces
PIANO_RH_ROUNDED_BINARY → RH_A_PERIOD RH_A_VARIATION RH_CODA_SHORT
{
  // Réduction binaire arrondie fiable de main droite de piano avec variation rythmique.
  // Nombre de mesures : 4 + 3 + 2 = 9 mesures.
  // La version précédente en 16 mesures atteignait RH_B_PERIOD dans le log mais ne terminait pas.
  // Ce routage garde une forme complète A / retour / cadence sans la coûteuse section modulante.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
  ↓1 = ↑;
  ↓2 = ↑;
  ↓3 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

@withoutSpaces
PIANO_LH_ROUNDED_BINARY → LH_A_PERIOD LH_A_VARIATION LH_CODA_SHORT
{
  // Route fiable de main gauche de piano alignée sur la main droite, avec figures d’accompagnement variées.
  // Nombre de mesures : 4 + 3 + 2 = 9 mesures.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
  ↓1 = ↑;
  ↓2 = ↑;
  ↓3 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

@withoutSpaces
RH_A_PERIOD → RH_TONIC_BROKEN_STYLE RH_PREDOMINANT_SUSTAINED_CHORDS RH_DOMINANT_BROKEN_STYLE RH_TONIC_SYNCOPATED_CHORDS
{
  // Ouverture de piano seul : alterne figures brisées en croches, harmonie tenue,
  // mouvement de dominante et réponse tonique syncopée. Cela évite quatre mesures identiques
  // d’accords en noires tout en gardant le même plan harmonique de 4 mesures.
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ⇑ = [last_function:tonic, tension:low];
}

@withoutSpaces
RH_A_VARIATION → RH_TONIC_ARPEGGIATED_CHORDS RH_CADENTIAL_SIX_FOUR RH_TONIC_CADENCE_CHORDS
{
  // Three-bar return variation: arpeggiated tonic, cadential 6/4, cadence.
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ⇑ = [last_function:tonic, tension:low];
}

@withoutSpaces
RH_B_PERIOD → RH_MODULATING_CHORDS RH_DOMINANT_KEY_CHORDS RH_DOMINANT_CHORDS
{
  [tonic_pc:$tonic_pc] ⊂ ↑;
  $new_key_abs = $tonic_pc + 7; $new_key_pc = $new_key_abs % 12;
  ↓1 = ↑;
  ↓2 = ↑ ∪ [tonic_pc:$new_key_pc];
  ↓3 = ↑ ∪ [tonic_pc:$new_key_pc];
  ⇑ = [home_tonic_pc:$tonic_pc, current_key_pc:$new_key_pc, last_function:dominant, tension:high];
}

@withoutSpaces
RH_A_RETURN → RH_TONIC_CHORDS RH_TONIC_CADENCE_CHORDS
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:tonic, tension:low]; }

@withoutSpaces
RH_CODA → RH_CADENTIAL_SIX_FOUR RH_DOMINANT_CHORDS RH_TONIC_CHORDS RH_FINAL_TONIC_CHORD
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ⇑ = [last_function:tonic, tension:resolved, cadence:final]; }

@withoutSpaces
RH_CODA_SHORT → RH_DOMINANT_CHORDS RH_FINAL_TONIC_CHORD
{
  // Cadence finale de 2 mesures pour la routage de piano fiable.
  ↓1 = ↑; ↓2 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

@withoutSpaces
LH_A_PERIOD → LH_ALBERTI_TONIC LH_PREDOMINANT_BASS_HALF LH_ALBERTI_DOMINANT LH_TONIC_BASS_LEAP
{
  // La main gauche de piano seul utilise des figures d’accompagnement plutôt que quatre
  // mesures de basse en noires : Alberti, soutien en blanches, dominante Alberti, basse par saut.
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ⇑ = [last_function:tonic, tension:low];
}

@withoutSpaces
LH_A_VARIATION → LH_TONIC_BASS_LEAP LH_DOMINANT_PEDAL_EIGHTHS LH_TONIC_BASS_HALF
{
  // Variation de basse plus courte alignée avec RH_A_VARIATION.
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ⇑ = [last_function:tonic, tension:low];
}

@withoutSpaces
LH_B_PERIOD → LH_MODULATING_BASS LH_DOMINANT_PEDAL_BASS LH_DOMINANT_BASS
{
  [tonic_pc:$tonic_pc] ⊂ ↑;
  $new_key_abs = $tonic_pc + 7; $new_key_pc = $new_key_abs % 12;
  ↓1 = ↑;
  ↓2 = ↑ ∪ [tonic_pc:$new_key_pc];
  ↓3 = ↑ ∪ [tonic_pc:$new_key_pc];
  ⇑ = [home_tonic_pc:$tonic_pc, current_key_pc:$new_key_pc, last_function:dominant, tension:high];
}

@withoutSpaces
LH_A_RETURN → LH_TONIC_BASS LH_TONIC_BASS
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:tonic, tension:low]; }

@withoutSpaces
LH_CODA → LH_CADENTIAL_BASS LH_DOMINANT_PEDAL_BASS LH_TONIC_BASS LH_FINAL_TONIC_BASS
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ⇑ = [last_function:tonic, tension:resolved, cadence:final]; }

@withoutSpaces
LH_CODA_SHORT → LH_DOMINANT_BASS LH_FINAL_TONIC_BASS
{
  // Cadence finale de basse de 2 mesures pour la routage de piano fiable.
  ↓1 = ↑; ↓2 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

// Fonctions d’accords de main droite. En majeur, I et IV sont majeurs ; en mineur, i et iv
// sont mineurs tandis que V reste majeur pour une sensible classique.
@withoutSpaces
RH_TONIC_CHORDS → CHORD_BAR4
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:4, q2:min, root3:7, q3:maj, root4:0, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_CHORDS → CHORD_BAR4
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:min, root2:3, q2:maj, root3:7, q3:maj, root4:0, q4:min], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_BROKEN_STYLE → CHORD_BAR4
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:7, q2:maj, root3:4, q3:min, root4:7, q4:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/2"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_BROKEN_STYLE → CHORD_BAR4
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:min, root2:7, q2:maj, root3:3, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/2"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_PREDOMINANT_CHORDS → CHORD_BAR4
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:maj, root2:2, q2:min, root3:7, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:predominant]; }

@withoutSpaces
RH_PREDOMINANT_CHORDS → CHORD_BAR4
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:min, root2:2, q2:dim, root3:7, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:predominant]; }

@withoutSpaces
RH_DOMINANT_CHORDS → CHORD_BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:7, q1:maj, root2:11, q2:dim, root3:7, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
RH_MODULATING_CHORDS → CHORD_BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:5, q2:maj, root3:2, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:pivot]; }

@withoutSpaces
RH_DOMINANT_KEY_CHORDS → CHORD_BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:4, q2:min, root3:7, q3:maj, root4:0, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:dominant_key]; }

