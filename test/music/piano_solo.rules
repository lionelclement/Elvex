// -----------------------------------------------------------------------------
// Plans formels supplémentaires pour piano_solo.
// Ces plans réutilisent le vocabulaire de piano stable ci-dessus, mais l’organisent en
// différentes formes formelles. Ils évitent l’ancienne routage modulant coûteuse de 16 mesures
// pour piano, afin que la génération reste praticable.
// -----------------------------------------------------------------------------

@withoutSpaces
PIANO_RH_TERNARY → RH_A_PERIOD RH_CONTRAST_PERIOD RH_A_RETURN RH_CODA_SHORT
{
  // A - contrasting B - A return - cadence.
  // 4 + 3 + 2 + 2 = 11 mesures en 4/4.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

@withoutSpaces
PIANO_LH_TERNARY → LH_A_PERIOD LH_CONTRAST_PERIOD LH_A_RETURN LH_CODA_SHORT
{
  // La main gauche reflète la grille formelle de la main droite.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

@withoutSpaces
RH_CONTRAST_PERIOD → RH_PREDOMINANT_SUSTAINED_CHORDS RH_DOMINANT_BROKEN_STYLE RH_TONIC_SYNCOPATED_CHORDS
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ⇑ = [last_function:tonic, tension:medium]; }

@withoutSpaces
LH_CONTRAST_PERIOD → LH_PREDOMINANT_BASS_HALF LH_DOMINANT_PEDAL_EIGHTHS LH_TONIC_BASS_HALF
{ ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ⇑ = [last_function:tonic, tension:medium]; }

@withoutSpaces
PIANO_RH_THEME_AND_VARIATIONS → RH_A_PERIOD RH_A_VARIATION RH_REGISTER_VARIATION RH_CODA_SHORT
{
  // Theme - rhythmic variation - brighter/chordal variation - cadence.
  // 4 + 3 + 3 + 2 = 12 mesures en 4/4.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑;
  ⇑ = [last_function:tonic, tension:resolved, cadence:final];
}

