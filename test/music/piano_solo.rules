RH_TONIC_CADENCE_CHORDS → CHORD_BAR4
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:maj, root2:7, q2:maj, root3:7, q3:maj, root4:0, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_CADENCE_CHORDS → CHORD_BAR4
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:min, root2:7, q2:maj, root3:7, q3:maj, root4:0, q4:min], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_CADENTIAL_SIX_FOUR → CHORD_BAR4
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:7, q2:maj, root3:0, q3:maj, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:cadential_six_four]; }

@withoutSpaces
RH_CADENTIAL_SIX_FOUR → CHORD_BAR4
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:min, root2:7, q2:maj, root3:0, q3:min, root4:7, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:cadential_six_four]; }

@withoutSpaces
RH_PREDOMINANT_SUSTAINED_CHORDS → CHORD_BAR2
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:maj, root2:7, q2:maj], rhythm:[r1:"1/2", r2:"1/2"]]; ⇑ = [last_function:predominant]; }

@withoutSpaces
RH_PREDOMINANT_SUSTAINED_CHORDS → CHORD_BAR2
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:5, q1:min, root2:7, q2:maj], rhythm:[r1:"1/2", r2:"1/2"]]; ⇑ = [last_function:predominant]; }

@withoutSpaces
RH_DOMINANT_BROKEN_STYLE → CHORD_BAR6
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:7, q1:maj, root2:11, q2:dim, root3:7, q3:maj, root4:11, q4:dim, root5:7, q5:maj, root6:7, q6:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
RH_TONIC_SYNCOPATED_CHORDS → CHORD_BAR6
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:4, q2:min, root3:7, q3:maj, root4:4, q4:min, root5:7, q5:maj, root6:0, q6:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_SYNCOPATED_CHORDS → CHORD_BAR6
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:min, root2:3, q2:maj, root3:7, q3:maj, root4:3, q4:maj, root5:7, q5:maj, root6:0, q6:min], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_ARPEGGIATED_CHORDS → CHORD_BAR6
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:maj, root2:7, q2:maj, root3:4, q3:min, root4:7, q4:maj, root5:0, q5:maj, root6:7, q6:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_TONIC_ARPEGGIATED_CHORDS → CHORD_BAR6
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, chords:[root1:0, q1:min, root2:7, q2:maj, root3:3, q3:maj, root4:7, q4:maj, root5:0, q5:min, root6:7, q6:maj], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
RH_FINAL_TONIC_CHORD → CHORD_BAR1
{ [mode:major, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, root:0, quality:maj, dur:"1/1"]; ⇑ = [last_function:tonic, cadence:final]; }

@withoutSpaces
RH_FINAL_TONIC_CHORD → CHORD_BAR1
{ [mode:minor, tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, root:0, quality:min, dur:"1/1"]; ⇑ = [last_function:tonic, cadence:final]; }

// Figures de basse et d’accompagnement de main gauche.
@withoutSpaces
LH_TONIC_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0, o2:7, o3:12, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
LH_PREDOMINANT_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:5, o2:12, o3:9, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:predominant]; }

@withoutSpaces
LH_DOMINANT_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7, o2:14, o3:11, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
LH_ALBERTI_TONIC → BAR8
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0, o2:7, o3:4, o4:7, o5:0, o6:7, o7:4, o8:7], rhythm:[r1:"1/8", r2:"1/8", r3:"1/8", r4:"1/8", r5:"1/8", r6:"1/8", r7:"1/8", r8:"1/8"]]; ⇑ = [last_function:tonic]; }

@withoutSpaces
LH_ALBERTI_DOMINANT → BAR8
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7, o2:14, o3:11, o4:14, o5:7, o6:14, o7:11, o8:14], rhythm:[r1:"1/8", r2:"1/8", r3:"1/8", r4:"1/8", r5:"1/8", r6:"1/8", r7:"1/8", r8:"1/8"]]; ⇑ = [last_function:dominant]; }

@withoutSpaces
LH_MODULATING_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0, o2:5, o3:2, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:pivot]; }

@withoutSpaces
LH_DOMINANT_PEDAL_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7, o2:7, o3:7, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:dominant, tension:high]; }

@withoutSpaces
LH_CADENTIAL_BASS → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0, o2:7, o3:12, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑ = [last_function:cadential_six_four]; }

