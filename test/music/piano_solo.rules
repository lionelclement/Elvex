PIANO_LH_THEME_AND_VARIATIONS → LH_A_PERIOD LH_A_VARIATION LH_REGISTER_VARIATION LH_CODA_SHORT
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode] ⊂ ↑;
