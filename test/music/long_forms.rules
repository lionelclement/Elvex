@withoutSpaces
MUSICAL_FORM → LONG_FLUTE1_TERNARY
{ [role:flute1|flute_piano_lead, form:long_ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_FLUTE1_TERNARY → FLUTE1_TERNARY_CONTROLLED FLUTE1_TERNARY_CONTROLLED FLUTE1_TERNARY_CONTROLLED FLUTE1_TERNARY_CONTROLLED
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[form:long_ternary, bars:32, controlled:true]; }

@withoutSpaces
MUSICAL_FORM → LONG_FLUTE2_TERNARY
{ [role:flute2, form:long_ternary, num:4, den:4, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_FLUTE2_TERNARY → REST_4_4_8 FLUTE2_TERNARY_CONTROLLED FLUTE2_TERNARY_CONTROLLED REST_4_4_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[form:long_ternary, bars:32, rests:true, controlled:true]; }


