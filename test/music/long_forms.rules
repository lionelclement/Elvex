// =============================================================================
// long_forms.rules
// =============================================================================
// Formes longues classiques : ternary, theme_and_variations, gigue, marche, sicilienne, etc. À utiliser avec des combinaisons style/form/rhythm cohérentes.
//

// -----------------------------------------------------------------------------
// Long-form architectures for 3–4 minute pieces.
//
// Note de conception :
// Les anciennes formes courtes restent inchangées. Ces formes longues sont sélectionnées par
// explicit form values:
//   long_rounded_binary
//   long_ternary
//   long_theme_and_variations
//   long_siciliana
//   long_gigue
//   long_march
//
// Les formes longues réutilisent des sections courtes stables. Les voix mélodiques secondaires
// se taisent parfois pendant des mesures entières en 4/4 ou composées afin que la voix principale puisse phraser seule.
// Bass/accompaniment/percussion roles stay comparatively continuous.
// -----------------------------------------------------------------------------

// --- Silences génériques d’une mesure entière -------------------------------

@withoutSpaces
REST_BAR4 → TAB REST BARLINE
{ ↓1 = []; ↓2 = [dur:"1/1"]; ↓3 = []; ⇑ = [rest:true]; }

@withoutSpaces
REST_BAR6_8 → TAB REST BARLINE
{ ↓1 = []; ↓2 = [dur:"3/4"]; ↓3 = []; ⇑ = [rest:true]; }

@withoutSpaces
REST_BAR3_4 → TAB REST BARLINE
{ ↓1 = []; ↓2 = [dur:"3/4"]; ↓3 = []; ⇑ = [rest:true]; }

REST_4_4_2 → REST_BAR4 REST_BAR4
{ ↓1=↑; ↓2=↑; ⇑=[rest_bars:2]; }
REST_4_4_4 → REST_4_4_2 REST_4_4_2
{ ↓1=↑; ↓2=↑; ⇑=[rest_bars:4]; }
REST_4_4_8 → REST_4_4_4 REST_4_4_4
{ ↓1=↑; ↓2=↑; ⇑=[rest_bars:8]; }
REST_4_4_16 → REST_4_4_8 REST_4_4_8
{ ↓1=↑; ↓2=↑; ⇑=[rest_bars:16]; }

REST_6_8_3 → REST_BAR6_8 REST_BAR6_8 REST_BAR6_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ⇑=[rest_bars:3]; }
REST_6_8_6 → REST_6_8_3 REST_6_8_3
{ ↓1=↑; ↓2=↑; ⇑=[rest_bars:6]; }

// --- Long rounded binary / ternary / variation forms ------------------------

@withoutSpaces
MUSICAL_FORM → LONG_FLUTE1_ROUNDED_BINARY
{ [role:flute1, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
LONG_FLUTE1_ROUNDED_BINARY → FLUTE1_ROUNDED_BINARY FLUTE1_ROUNDED_BINARY FLUTE1_ROUNDED_BINARY FLUTE1_ROUNDED_BINARY
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[form:long_rounded_binary, bars:64]; }

@withoutSpaces
MUSICAL_FORM → LONG_FLUTE_PIANO_LEAD_ROUNDED_BINARY
{ [role:flute_piano_lead, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
LONG_FLUTE_PIANO_LEAD_ROUNDED_BINARY → FLUTE1_ROUNDED_BINARY REST_4_4_8 FLUTE_PIANO_LEAD_EIGHT_BAR FLUTE1_ROUNDED_BINARY REST_4_4_8 FLUTE_PIANO_LEAD_EIGHT_BAR
{
  // 64 mesures au total : 16 + 8 de silence + 8 + 16 + 8 de silence + 8.
  // La voix principale respire entre les grandes phrases au lieu de jouer en continu.
  ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑;
  ⇑=[form:long_rounded_binary, bars:64, lead_rests:16];
}

@withoutSpaces
MUSICAL_FORM → LONG_FLUTE2_ROUNDED_BINARY
{ [role:flute2, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }

@withoutSpaces
LONG_FLUTE2_ROUNDED_BINARY → REST_4_4_16 FLUTE2_ROUNDED_BINARY REST_4_4_16 FLUTE2_ROUNDED_BINARY
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ⇑=[form:long_rounded_binary, bars:64, rests:32]; }

@withoutSpaces
MUSICAL_FORM → LONG_PIANO_RH_ROUNDED_BINARY
{ [role:piano_rh, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_PIANO_RH_ROUNDED_BINARY → PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY PIANO_RH_ROUNDED_BINARY
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[form:long_rounded_binary, bars:72]; }

@withoutSpaces
MUSICAL_FORM → LONG_PIANO_LH_ROUNDED_BINARY
{ [role:piano_lh, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_PIANO_LH_ROUNDED_BINARY → PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY PIANO_LH_ROUNDED_BINARY
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑; ⇑=[form:long_rounded_binary, bars:72]; }

@withoutSpaces
MUSICAL_FORM → LONG_PIANO_ACC_RH_ROUNDED_BINARY
{ [role:piano_acc_rh, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_PIANO_ACC_RH_ROUNDED_BINARY → PIANO_ACC_RH_ROUNDED_BINARY ACC_RH_LONG_SPARSE_8 ACC_RH_LONG_PAD_8 PIANO_ACC_RH_ROUNDED_BINARY ACC_RH_LONG_SPARSE_8 ACC_RH_LONG_PAD_8 PIANO_ACC_RH_ROUNDED_BINARY ACC_RH_LONG_SPARSE_8
{
  // 8 blocs de 8 mesures = 64 mesures. La main droite alterne nappes, respirations espacées
  // et accompagnement original pour éviter la répétition mécanique.
  ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑;
  ⇑=[form:long_rounded_binary, bars:64, texture:varied_accompaniment];
}

@withoutSpaces
MUSICAL_FORM → LONG_PIANO_ACC_LH_ROUNDED_BINARY
{ [role:piano_acc_lh, form:long_rounded_binary, rhythm:[topic:neutral]]; ↓1=↑; ⇑=⇓1; }
@withoutSpaces
LONG_PIANO_ACC_LH_ROUNDED_BINARY → PIANO_ACC_LH_ROUNDED_BINARY ACC_LH_LONG_SIMPLE_8 ACC_LH_LONG_BROKEN_8 PIANO_ACC_LH_ROUNDED_BINARY ACC_LH_LONG_SIMPLE_8 ACC_LH_LONG_BROKEN_8 PIANO_ACC_LH_ROUNDED_BINARY ACC_LH_LONG_SIMPLE_8
{
  // 8 blocs de 8 mesures = 64 mesures. La basse reste continue, mais alterne
  // between broken figures, simpler basses and pedals.
  ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ↓8=↑;
  ⇑=[form:long_rounded_binary, bars:64, texture:varied_bass];
}

