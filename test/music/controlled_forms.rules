ACC_RH_CTL_VARIATION_TWO → ACC_RH_TONIC_HOLD ACC_RH_CADENCE_PAD
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:tonic, tension:low]; }

@withoutSpaces
ACC_LH_CTL_VARIATION_TWO → ACC_LH_TONIC_BROKEN ACC_LH_DOMINANT_BASS
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:dominant, tension:medium]; }
