@withoutSpaces
ACC_RH_CTL_CONTRAST_TWO → ACC_RH_SUBDOMINANT_PAD ACC_RH_DOMINANT_PAD
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:dominant, tension:medium]; }

@withoutSpaces
ACC_LH_CTL_CONTRAST_TWO → ACC_LH_SUBDOMINANT_BASS ACC_LH_DOMINANT_PEDAL
{ ↓1 = ↑; ↓2 = ↑; ⇑ = [last_function:dominant, tension:medium]; }

