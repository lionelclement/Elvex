PIANO_ACC_RH_THEME_AND_VARIATIONS_CONTROLLED → ACC_RH_A_PERIOD ACC_RH_CTL_VARIATION_TWO ACC_RH_CODA_SHORT
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, mode:$mode, num:4, den:4] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑;
