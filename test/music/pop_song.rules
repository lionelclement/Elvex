// =============================================================================
// pop_song.rules
// =============================================================================
// Formes pop couplet/refrain et accompagnement guitare. Utilise les rôles pop_vocal_guide et pop_guitar.
//

// -----------------------------------------------------------------------------
// Module de chanson pop robuste pour Elvex.
// Objectif : produire de façon fiable des .ly non vides pour 300-303.
// 64 mesures : intro, couplet, refrain, couplet, pont, refrain, final, outro.
// Les règles utilisent seulement les terminaux stables de bas niveau déjà présents dans bars.rules :
// BAR1, BAR2, BAR4, CHORD_BAR1 et CHORD_BAR4.
// -----------------------------------------------------------------------------


// --- Secours pop direct -----------------------------------------------------
// Les règles pop compositionnelles ci-dessous sont conservées, mais les quatre routes par tonalité exacte suivantes
// garantissent une partition non vide pour les entrées pop actuels
// 300-303. Elles évitent les longues dérivations fragiles pendant que nous continuons à améliorer le
// generative pop grammar.

@withoutSpaces
// -----------------------------------------------------------------------------
// Entrées pop : MUSICAL_FORM choisit une ligne vocale ou une guitare selon role.
// Les entrées pop doivent donc utiliser les rôles pop_vocal_guide et pop_guitar.
// -----------------------------------------------------------------------------
MUSICAL_FORM → POP_DIRECT_LEAD_C_MAJOR
{ [role:pop_vocal_guide, form:pop_song_verse_chorus, tonic:c, mode:major] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }
@withoutSpaces
MUSICAL_FORM → POP_DIRECT_GUITAR_C_MAJOR
{ [role:pop_guitar, form:pop_song_verse_chorus, tonic:c, mode:major] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }

@withoutSpaces
MUSICAL_FORM → POP_DIRECT_LEAD_A_MINOR
{ [role:pop_vocal_guide, form:pop_song_verse_chorus, tonic:a, mode:minor] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }
@withoutSpaces
MUSICAL_FORM → POP_DIRECT_GUITAR_A_MINOR
{ [role:pop_guitar, form:pop_song_verse_chorus, tonic:a, mode:minor] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }

@withoutSpaces
MUSICAL_FORM → POP_DIRECT_LEAD_G_MAJOR
{ [role:pop_vocal_guide, form:pop_song_verse_chorus, tonic:g, mode:major] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }
@withoutSpaces
MUSICAL_FORM → POP_DIRECT_GUITAR_G_MAJOR
{ [role:pop_guitar, form:pop_song_verse_chorus, tonic:g, mode:major] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }

@withoutSpaces
MUSICAL_FORM → POP_DIRECT_LEAD_E_MINOR
{ [role:pop_vocal_guide, form:pop_song_verse_chorus, tonic:e, mode:minor] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }
@withoutSpaces
MUSICAL_FORM → POP_DIRECT_GUITAR_E_MINOR
{ [role:pop_guitar, form:pop_song_verse_chorus, tonic:e, mode:minor] ⊂ ↑; ↓1=[]; ⇑=[direct_pop:true]; }

@withoutSpaces
MUSICAL_FORM → POP_LEAD_MELODY_SONG
{
  [role:pop_vocal_guide, form:pop_song_verse_chorus, tonic_pc:$tonic_pc, mode:$mode, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, mode:$mode, octave:$octave, accidental_policy:$accidental_policy];
  ⇑ = ⇓1;
}

@withoutSpaces
MUSICAL_FORM → POP_GUITAR_SONG
{
  [role:pop_guitar, form:pop_song_verse_chorus, tonic_pc:$tonic_pc, mode:$mode, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, mode:$mode, octave:$octave, accidental_policy:$accidental_policy];
  ⇑ = ⇓1;
}

