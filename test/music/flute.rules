// -----------------------------------------------------------------------------
// Formes de flûte conductrice utilisées spécifiquement dans flute_piano_duet.
// Elles sont alignées avec les plans d’accompagnement de piano_accompaniment.rules :
// ternary              = 11 mesures
// theme_and_variations = 9 mesures
// minuet_trio          = 13 mesures en 3/4
// La flûte reste la voix mélodique principale ; le piano reste accompagnateur.
// -----------------------------------------------------------------------------

@withoutSpaces
FLUTE_PIANO_LEAD_TERNARY → FLP_A_PERIOD FLP_CONTRAST_PERIOD FLP_A_RETURN FLP_CODA_SHORT
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; [last_offset:$a] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a]; [last_offset:$b] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b]; [last_offset:$c] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$c];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE_PIANO_LEAD_THEME_AND_VARIATIONS → FLP_A_PERIOD FLP_VARIATION FLP_CODA_SHORT
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; [last_offset:$a] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a]; [last_offset:$b] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b];
  ⇑ = ⇓3;
}

@withoutSpaces
FLUTE_PIANO_LEAD_MINUET_TRIO → FLUTE1_MINUET_TRIO
{
  // Réutilise le dessin complet de menuet/trio de Flûte I. L’accompagnement de piano
  // du menuet/trio possède la même grille de 13 mesures.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, num:3, den:4] ⊂ ↑;
  ↓1 = ↑;
  ⇑ = ⇓1;
}

@withoutSpaces
FLP_A_PERIOD → FL1_OPENING_MOTIF FL1_ANSWER_MOTIF FL1_HALF_CADENCE FL1_AUTHENTIC_CADENCE
{ ↓1 = ↑; [last_offset:$a] ⊂ ⇓1; ↓2 = ↑ ∪ [opening_offset:$a]; [last_function:$f2] ⊂ ⇓2; ↓3 = ↑ ∪ [previous_function:$f2]; [last_function:$f3] ⊂ ⇓3; ↓4 = ↑ ∪ [previous_function:$f3]; ⇑ = ⇓4; }

@withoutSpaces
FLP_CONTRAST_PERIOD → FL1_MODULATING_MOTIF FL1_SEQUENCE_MOTIF FL1_AUTHENTIC_CADENCE
{ ↓1 = ↑; [last_offset:$a] ⊂ ⇓1; ↓2 = ↑ ∪ [opening_offset:$a]; [last_function:$f2] ⊂ ⇓2; ↓3 = ↑ ∪ [previous_function:$f2]; ⇑ = ⇓3; }

@withoutSpaces
FLP_A_RETURN → FL1_RETURN_MOTIF FL1_AUTHENTIC_CADENCE
{ ↓1 = ↑; [last_function:$f1] ⊂ ⇓1; ↓2 = ↑ ∪ [previous_function:$f1]; ⇑ = ⇓2; }

@withoutSpaces
FLP_VARIATION → FL1_ECHO_MOTIF FL1_SEQUENCE_MOTIF FL1_AUTHENTIC_CADENCE
{ ↓1 = ↑; [last_offset:$a] ⊂ ⇓1; ↓2 = ↑ ∪ [opening_offset:$a]; [last_function:$f2] ⊂ ⇓2; ↓3 = ↑ ∪ [previous_function:$f2]; ⇑ = ⇓3; }

@withoutSpaces
FLP_CODA_SHORT → FL1_DOMINANT_PREP FL1_FINAL_RESOLUTION
{ ↓1 = ↑; [last_function:$f1] ⊂ ⇓1; ↓2 = ↑ ∪ [previous_function:$f1]; ⇑ = ⇓2; }
