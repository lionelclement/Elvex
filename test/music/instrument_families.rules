// =============================================================================
// instrument_families.rules
// =============================================================================
// Règles génériques pour familles d'instruments : cordes, bois, cuivres, guitare, percussions, ensembles mixtes. Elles donnent des motifs utilisables selon family et role.
//

// -----------------------------------------------------------------------------
// Matériau générique par famille d’instruments.
//
// Objectif : ajouter de nouveaux instruments sans dupliquer chaque plan formel par instrument.
// Les enveloppes de staves.rules associent les instruments concrets à :
//   role   = lead, countermelody, inner_voice, bass, harmonic_support,
//            rhythmic_pedal, accent
//   family = woodwind, bowed_strings, brass, percussion
//
// Ces règles fournissent actuellement un matériau rounded_binary prudent. Elles sont
// volontairement simples et stables : de futures règles idiomatiques pourront spécialiser par
// famille tout en gardant la même interface role/form.
// -----------------------------------------------------------------------------

// --- Dispatch générique par rôle --------------------------------------------

@withoutSpaces
// -----------------------------------------------------------------------------
// Entrées génériques par famille instrumentale.
// Utiles pour les ensembles custom ou mixtes quand aucun module spécialisé
// n'est plus précis.
// -----------------------------------------------------------------------------
MUSICAL_FORM → FAMILY_LEAD_ROUNDED_BINARY
{ [role:lead, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_COUNTERMELODY_ROUNDED_BINARY
{ [role:countermelody, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_INNER_VOICE_ROUNDED_BINARY
{ [role:inner_voice, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_BASS_ROUNDED_BINARY
{ [role:bass, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_HARMONIC_SUPPORT_ROUNDED_BINARY
{ [role:harmonic_support, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_RHYTHMIC_PEDAL_ROUNDED_BINARY
{ [role:rhythmic_pedal|bass_accent, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FAMILY_ACCENT_ROUNDED_BINARY
{ [role:accent|cadence_accent, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

// --- Lead / counterline / support plans -------------------------------------

@withoutSpaces
FAMILY_LEAD_ROUNDED_BINARY → FAMILY_LEAD_A FAMILY_LEAD_A_VARIANT FAMILY_LEAD_B FAMILY_LEAD_RETURN FAMILY_LEAD_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑;
  ↓2 = ↑;
  ↓3 = ↑;
  ↓4 = ↑;
  ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_COUNTERMELODY_ROUNDED_BINARY → FAMILY_COUNTER_A FAMILY_COUNTER_A FAMILY_COUNTER_B FAMILY_COUNTER_RETURN FAMILY_COUNTER_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_INNER_VOICE_ROUNDED_BINARY → FAMILY_INNER_A FAMILY_INNER_A FAMILY_INNER_B FAMILY_INNER_RETURN FAMILY_INNER_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_HARMONIC_SUPPORT_ROUNDED_BINARY → FAMILY_SUPPORT_A FAMILY_SUPPORT_A FAMILY_SUPPORT_B FAMILY_SUPPORT_RETURN FAMILY_SUPPORT_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_BASS_ROUNDED_BINARY → FAMILY_BASS_A FAMILY_BASS_A FAMILY_BASS_B FAMILY_BASS_RETURN FAMILY_BASS_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_RHYTHMIC_PEDAL_ROUNDED_BINARY → FAMILY_PERC_PEDAL_A FAMILY_PERC_PEDAL_A FAMILY_PERC_PEDAL_B FAMILY_PERC_PEDAL_RETURN FAMILY_PERC_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
FAMILY_ACCENT_ROUNDED_BINARY → FAMILY_PERC_ACCENT_A FAMILY_PERC_ACCENT_A FAMILY_PERC_ACCENT_B FAMILY_PERC_ACCENT_RETURN FAMILY_PERC_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

// --- Cellules d’une mesure : rôles mélodiques ------------------------------

@withoutSpaces
FAMILY_LEAD_A → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:2, o3:4, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_LEAD_A_VARIANT → BAR4_SLURRED
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:9, o3:11, o4:12], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_LEAD_B → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:12, o2:11, o3:9, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_LEAD_RETURN → BAR4_SLURRED
{
  ↓1 = ↑ ∪ [motif:[o1:4, o2:5, o3:7, o4:0], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_LEAD_CODA → BAR1
{
  ↓1 = ↑ ∪ [motif:[o1:0], rhythm:[r1:"1/1"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_COUNTER_A → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:4, o2:7, o3:5, o4:4], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_COUNTER_B → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:5, o3:4, o4:2], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_COUNTER_RETURN → BAR4_SLURRED
{
  ↓1 = ↑ ∪ [motif:[o1:2, o2:4, o3:5, o4:4], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_COUNTER_CODA → BAR1
{
  ↓1 = ↑ ∪ [motif:[o1:4], rhythm:[r1:"1/1"]];
  ⇑ = ⇓1;
}

