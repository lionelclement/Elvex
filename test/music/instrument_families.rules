FAMILY_BASS_RETURN → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:7, o3:0, o4:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

