// --- Cellules d’une mesure : secours pseudo-percussif en hauteurs ----------
// Elles utilisent des terminaux NOTE ordinaires afin que la même mécanique de portée LilyPond fonctionne.
// Un futur percussion.lexicon pourra remplacer cela par des tokens spécifiques à \drummode.

@withoutSpaces
FAMILY_PERC_PEDAL_A → BAR4_STACCATO
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:0, o3:0, o4:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_PEDAL_B → BAR4_STACCATO
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:7, o3:7, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_PEDAL_RETURN → BAR4_STACCATO
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:0, o3:7, o4:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_ACCENT_A → BAR4_REST_AFTER_1
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:7, o3:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", rr:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_ACCENT_B → BAR4_REST_AFTER_1
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:0, o3:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", rr:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_ACCENT_RETURN → BAR4_STACCATO
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:7, o3:0, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_PERC_CODA → BAR1
{
  ↓1 = ↑ ∪ [motif:[o1:0], rhythm:[r1:"1/1"]];
  ⇑ = ⇓1;
}

// -----------------------------------------------------------------------------
// Ajouts guitare et batterie.
// La guitare est traitée comme plucked_strings : clé treble_8 et soutien arpégé.
// La batterie est traitée comme percussion non mélodique utilisant la clé de percussion, mais
// l’implémentation actuelle réutilise encore des terminaux NOTE comme substituts rythmiques.
// Un futur percussion.lexicon pourra les remplacer par de vrais tokens \drummode.
// -----------------------------------------------------------------------------

@withoutSpaces
MUSICAL_FORM → GUITAR_ROUNDED_BINARY
{ [role:guitar, family:plucked_strings, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → DRUM_KIT_ROUNDED_BINARY
{ [role:drum_kit, family:percussion, form:rounded_binary]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
GUITAR_ROUNDED_BINARY → GUITAR_STRUM_TONIC GUITAR_A GUITAR_STRUM_PREDOMINANT GUITAR_RETURN GUITAR_STRUM_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

// Un plan de guitare un peu plus harmonique. Les anciens GUITAR_A/GUITAR_RETURN
// sont conservées, mais alternées avec de vraies mesures CHORD grattées afin que
// la guitare ne sonne pas seulement comme des arpèges monodiques.


@withoutSpaces
GUITAR_STRUM_TONIC → CHORD_BAR2
{
  // Deux larges accords de tonique grattés. En majeur : I - V.
  [mode:major] ⊂ ↑;
  ↓1 = ↑ ∪ [chords:[root1:0, q1:maj, root2:7, q2:maj], rhythm:[r1:"1/2", r2:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_STRUM_TONIC → CHORD_BAR2
{
  // Minor-key tonic version: i - V.
  [mode:minor] ⊂ ↑;
  ↓1 = ↑ ∪ [chords:[root1:0, q1:min, root2:7, q2:maj], rhythm:[r1:"1/2", r2:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_STRUM_PREDOMINANT → CHORD_BAR4
{
  // Simple four-beat guitar accompaniment: I - IV - V - I.
  [mode:major] ⊂ ↑;
  ↓1 = ↑ ∪ [chords:[root1:0, q1:maj, root2:5, q2:maj, root3:7, q3:maj, root4:0, q4:maj], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_STRUM_PREDOMINANT → CHORD_BAR4
{
  // Minor-key version: i - iv - V - i.
  [mode:minor] ⊂ ↑;
  ↓1 = ↑ ∪ [chords:[root1:0, q1:min, root2:5, q2:min, root3:7, q3:maj, root4:0, q4:min], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_STRUM_CODA → CHORD_BAR1
{
  [mode:major] ⊂ ↑;
  ↓1 = ↑ ∪ [root:0, quality:maj, dur:"1/1"];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_STRUM_CODA → CHORD_BAR1
{
  [mode:minor] ⊂ ↑;
  ↓1 = ↑ ∪ [root:0, quality:min, dur:"1/1"];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_A → BAR4_SLURRED
{
  // Broken tonic sonority: root, fifth, octave, third above.
  ↓1 = ↑ ∪ [motif:[o1:0, o2:7, o3:12, o4:16], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_A_VARIANT → BAR4
{
  // Slightly more rhythmic answer, still stable and playable.
  ↓1 = ↑ ∪ [motif:[o1:0, o2:4, o3:7, o4:12], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_B → BAR4_SLURRED
{
  // Predominant/dominant color.
  ↓1 = ↑ ∪ [motif:[o1:5, o2:12, o3:7, o4:11], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_RETURN → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:7, o2:12, o3:4, o4:0], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/2"]];
  ⇑ = ⇓1;
}

@withoutSpaces
GUITAR_CODA → BAR1
{
  ↓1 = ↑ ∪ [motif:[o1:0], rhythm:[r1:"1/1"]];
  ⇑ = ⇓1;
}

@withoutSpaces
DRUM_KIT_ROUNDED_BINARY → DRUM_KIT_A DRUM_KIT_A DRUM_KIT_B DRUM_KIT_RETURN DRUM_KIT_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; ↓2 = ↑; ↓3 = ↑; ↓4 = ↑; ↓5 = ↑;
  ⇑ = [last_function:tonic, tension:resolved];
}

@withoutSpaces
DRUM_KIT_A → BAR4_STACCATO
{
  // Kick/snare-like placeholder: low/high/low/high on quarter pulses.
  ↓1 = ↑ ∪ [motif:[o1:0, o2:7, o3:0, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
DRUM_KIT_B → BAR4_REST_AFTER_1
{
  // Mesure plus légère avec un silence à la fin.
  ↓1 = ↑ ∪ [motif:[o1:7, o2:7, o3:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", rr:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
DRUM_KIT_RETURN → BAR4_STACCATO
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:7, o3:7, o4:0], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
DRUM_KIT_CODA → BAR1
{
  ↓1 = ↑ ∪ [motif:[o1:0], rhythm:[r1:"1/1"]];
  ⇑ = ⇓1;
}
