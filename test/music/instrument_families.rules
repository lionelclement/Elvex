@withoutSpaces
FAMILY_BASS_A → BAR4
{
  ↓1 = ↑ ∪ [motif:[o1:0, o2:0, o3:7, o4:7], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]];
  ⇑ = ⇓1;
}

@withoutSpaces
FAMILY_BASS_B → BAR4
{
