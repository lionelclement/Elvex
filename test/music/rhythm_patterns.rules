// =============================================================================
// rhythm_patterns.rules
// =============================================================================
// Variantes rythmiques et danses. Les traits music.rhythm.topic, dance, density et articulation orientent vers sicilienne, gigue, marche, sarabande, syncopes, etc.
//

// -----------------------------------------------------------------------------
// rhythm_patterns.rules
// -----------------------------------------------------------------------------
// Topics rythmiques / danses optionnels sélectionnés depuis music.entrée :
//
//   music:[ rhythm:[topic:siciliana, dance:none, ...] ]
//
// Design:
// - form reste l’architecture à grande échelle, généralement rounded_binary.
//   - rhythm.topic / rhythm.dance sélectionnent les cellules caractéristiques.
// - Les formes classiques existantes sont gardées par rhythm.topic:neutral, donc un
// topic non neutre route ici au lieu de faire exploser l’ambiguïté.
//
// Ce premier module implémente des routes courtes et stables pour les familles métriques
// les plus utiles. D’autres danses pourront recevoir leurs propres cellules tout en gardant le
// même schéma d’entrée.
// -----------------------------------------------------------------------------

// --- 6/8 compound topics: siciliana, lullaby, gallop/gigue ------------------

@withoutSpaces
// -----------------------------------------------------------------------------
// Entrées rythmiques.
// Ces routages sont activées par music.rhythm.topic / dance / density. Elles
// permettent de colorer une forme sans changer tout l'ensemble.
// -----------------------------------------------------------------------------
MUSICAL_FORM → RHYTHM_FLUTE_SICILIANA_MELODY
{ [role:flute1, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_FLUTE_SICILIANA_SUPPORT
{ [role:flute2, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_FLUTE_SICILIANA_MELODY
{ [role:flute_piano_lead, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_PIANO_RH_SICILIANA
{ [role:piano_rh, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_PIANO_LH_SICILIANA
{ [role:piano_lh, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_PIANO_ACC_RH_SICILIANA
{ [role:piano_acc_rh, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → RHYTHM_PIANO_ACC_LH_SICILIANA
{ [role:piano_acc_lh, form:rounded_binary, rhythm:[topic:siciliana], num:6, den:8]; ↓1 = ↑; ⇑ = ⇓1; }

// Gigue / gallop réutilisent le même routage en 6/8, mais avec un patron plus actif.
@withoutSpaces
MUSICAL_FORM → RHYTHM_FLUTE_GALLOP_MELODY
