// --- Cellules de flûte en 6/8 ----------------------------------------------

SICILIANA_CALL → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
      motif:[o1:0,o2:2,o3:4,o4:7,o5:5,o6:4], rhythm:[r1:"3/16",r2:"1/16",r3:"1/8",r4:"3/16",r5:"1/16",r6:"1/8"]]; ⇑=[last_function:siciliana_call];
}
SICILIANA_ANSWER → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
      motif:[o1:4,o2:5,o3:7,o4:9,o5:7,o6:5], rhythm:[r1:"3/16",r2:"1/16",r3:"1/8",r4:"3/16",r5:"1/16",r6:"1/8"]]; ⇑=[last_function:siciliana_answer];
}
SICILIANA_SEQUENCE → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
      motif:[o1:5,o2:7,o3:9,o4:12,o5:11,o6:9], rhythm:[r1:"3/16",r2:"1/16",r3:"1/8",r4:"3/16",r5:"1/16",r6:"1/8"]]; ⇑=[last_function:siciliana_sequence];
}
SICILIANA_CADENCE → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
      motif:[o1:7,o2:5,o3:4,o4:2,o5:0,o6:0], rhythm:[r1:"3/16",r2:"1/16",r3:"1/8",r4:"3/16",r5:"1/16",r6:"1/8"]]; ⇑=[last_function:siciliana_cadence_diatonic];
}
SICILIANA_SUPPORT_TONIC → BAR6
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0,o2:7,o3:4,o4:0,o5:7,o6:4], rhythm:[r1:"1/8",r2:"1/8",r3:"1/8",r4:"1/8",r5:"1/8",r6:"1/8"]]; ⇑=[last_function:support_tonic]; }
SICILIANA_SUPPORT_DOMINANT → BAR6
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7,o2:14,o3:11,o4:7,o5:14,o6:11], rhythm:[r1:"1/8",r2:"1/8",r3:"1/8",r4:"1/8",r5:"1/8",r6:"1/8"]]; ⇑=[last_function:support_dominant]; }
SICILIANA_SUPPORT_CADENCE → BAR6
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7,o2:5,o3:4,o4:2,o5:0,o6:0], rhythm:[r1:"1/8",r2:"1/8",r3:"1/8",r4:"1/8",r5:"1/8",r6:"1/8"]]; ⇑=[last_function:support_cadence_diatonic]; }

GALLOP_BAR → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:0,o2:4,o3:7,o4:4], rhythm:[r1:"1/4",r2:"1/8",r3:"1/4",r4:"1/8"]]; ⇑=[last_function:gallop_broad]; }
GALLOP_SEQUENCE → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:5,o2:9,o3:12,o4:9], rhythm:[r1:"1/4",r2:"1/8",r3:"1/4",r4:"1/8"]]; ⇑=[last_function:gallop_sequence_broad]; }
GALLOP_CADENCE → BAR4
{ [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑; ↓1=[tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, motif:[o1:7,o2:5,o3:4,o4:0], rhythm:[r1:"1/4",r2:"1/8",r3:"1/4",r4:"1/8"]]; ⇑=[last_function:gallop_cadence_broad]; }

