S → (X|Y) Z
{
  if (#1) {
    if (#1 . 1) {
      ↓2 = [case:X];
    }
    else {
      if (#1 . 2) {
        ↓2 = [case:Y];
      }
      else {
        ↓2 = [case:ERR];
      }
    }
  }
  else {
    ↓2 = [case:none];
  }

  ↓1 = [];
}

X → x
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

Y → y
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

Z → z
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}
