/*
 * Lexical verb valencies.
 * i   = subject (realized by the clause rules)
 * ii  = first complement
 * iii = second complement
 */

MainVP → LexVP
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

MainVP → CopVP
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

// intransitive: John sleeps.
LexVP → verb
{
  [HEAD:$HEAD, SUBJECT:$SUBJECT, ii:NIL, iii:NIL, vtense:$vtense, $Rest];
  ↓1 = [HEAD:$HEAD, SUBJECT:$SUBJECT, vtense:$vtense, $Rest];
  [valency:$VALENCY] ⊂ ⇓1;
  attest ($VALENCY == intransitive);
  ⇑ = ⇓1;
}

// transitive: John reads the book.
LexVP → verb NP
{
  [HEAD:$HEAD, SUBJECT:$SUBJECT, ii:$OBJECT, iii:NIL, vtense:$vtense, $Rest];
  ↓1 = [HEAD:$HEAD, SUBJECT:$SUBJECT, vtense:$vtense, $Rest];
  [valency:$VALENCY] ⊂ ⇓1;
  attest ($VALENCY == transitive);
  ↓2 = $OBJECT U [case:accusative];
  ⇑ = ⇓1;
}

// ditransitive: John gives Mary the book.
LexVP → verb NP NP
{
  [HEAD:$HEAD, SUBJECT:$SUBJECT, ii:$OBJECT1, iii:$OBJECT2, vtense:$vtense, $Rest];
  ↓1 = [HEAD:$HEAD, SUBJECT:$SUBJECT, vtense:$vtense, $Rest];
  [valency:$VALENCY] ⊂ ⇓1;
  attest ($VALENCY == ditransitive);
  ↓2 = $OBJECT1 U [case:accusative];
  ↓3 = $OBJECT2 U [case:accusative];
  ⇑ = ⇓1;
}

// prepositional complement: John listens to the music.
LexVP → verb prep NP
{
  [HEAD:$HEAD, SUBJECT:$SUBJECT, ii:$OBJECT, iii:NIL, vtense:$vtense, $Rest];
  ↓1 = [HEAD:$HEAD, SUBJECT:$SUBJECT, vtense:$vtense, $Rest];
  [valency:$VALENCY, pcase:$pcase] ⊂ ⇓1;
  attest ($VALENCY == prepositional);
  ↓2 = [pcase:$pcase];
  ↓3 = $OBJECT U [case:accusative];
  ⇑ = ⇓1;
}

// direct object + PP: John puts the book on the table.
LexVP → verb NP prep NP
{
  [HEAD:$HEAD, SUBJECT:$SUBJECT, ii:$OBJECT, iii:$OBLIQUE, vtense:$vtense, $Rest];
  ↓1 = [HEAD:$HEAD, SUBJECT:$SUBJECT, vtense:$vtense, $Rest];
  [valency:$VALENCY, pcase:$pcase] ⊂ ⇓1;
  attest ($VALENCY == transitive_prepositional);
  ↓2 = $OBJECT U [case:accusative];
  ↓3 = [pcase:$pcase];
  ↓4 = $OBLIQUE U [case:accusative];
  ⇑ = ⇓1;
}
