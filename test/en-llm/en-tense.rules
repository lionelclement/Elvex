/* 12 conventional English tense/aspect combinations. */

// present simple — declarative, positive
TenseClause → NP LexVP
{
  [HEAD:$HEAD, i:$SUBJECT, ii:$II, iii:$III, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative, $Rest];
  ↓1 = $SUBJECT U [case:nominative];
  $SynthSubject = ⇓1;
  [person:$person, number:$number] ⊂ $SynthSubject;
  ↓2 = [HEAD:$HEAD, ii:$II, iii:$III, SUBJECT:$SynthSubject, vtense:present, $Rest];
  ⇑ = ⇓2;
}

// present simple — declarative, negative
TenseClause → NP aux_do neg LexVP
{
  [HEAD:$HEAD, i:$SUBJECT, ii:$II, iii:$III, tense:present, aspect:simple, modality:none, polarity:negative, illocution:declarative, $Rest];
  ↓1 = $SUBJECT U [case:nominative];
  $SynthSubject = ⇓1;
  [person:$person, number:$number] ⊂ $SynthSubject;
  ↓2 = [aux_tense:present, SUBJECT:$SynthSubject];
  ↓3 = [];
  ↓4 = [HEAD:$HEAD, ii:$II, iii:$III, SUBJECT:$SynthSubject, vtense:infinitive, $Rest];
  ⇑ = ⇓4;
}

// present simple — interrogative, positive
TenseClause → aux_do NP LexVP
