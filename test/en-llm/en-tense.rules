  $SynthSubject = ⇓2;
  [person:$person, number:$number] ⊂ $SynthSubject;
  ↓1 = [aux_tense:present, SUBJECT:$SynthSubject];
  ↓3 = [HEAD:$HEAD, ii:$II, iii:$III, SUBJECT:$SynthSubject, vtense:infinitive, $Rest];
  ⇑ = ⇓3;
}

