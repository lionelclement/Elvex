// V03 ditransitive
Axiom [HEAD:TO_GIVE, i:[HEAD:JOHN], ii:[HEAD:MARY], iii:[HEAD:BOOK, number:sg, def:true], tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
// V04 prepositional
Axiom [HEAD:TO_LISTEN, i:[HEAD:JOHN], ii:[HEAD:MUSIC, number:sg, def:true], iii:NIL, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
// V05 transitive+PP
Axiom [HEAD:TO_PUT, i:[HEAD:JOHN], ii:[HEAD:BOOK, number:sg, def:true], iii:[HEAD:TABLE, number:sg, def:true], tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
// V06 copular adjective
Axiom [HEAD:TO_BE, i:[HEAD:JOHN], ii:[HEAD:HAPPY], iii:NIL, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
// V07 copular NP
Axiom [HEAD:TO_BE, i:[HEAD:JOHN], ii:[HEAD:STUDENT, number:sg, def:indefinite], iii:NIL, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
// V08 copular negative
Axiom [HEAD:TO_BE, i:[HEAD:JOHN], ii:[HEAD:HAPPY], iii:NIL, tense:past, aspect:simple, modality:none, polarity:negative, illocution:declarative]
// V09 copular question
Axiom [HEAD:TO_BE, i:[HEAD:JOHN], ii:[HEAD:HAPPY], iii:NIL, tense:present, aspect:simple, modality:none, polarity:positive, illocution:interrogative]
// V10 copular interro-negative
Axiom [HEAD:TO_BE, i:[HEAD:JOHN], ii:[HEAD:HAPPY], iii:NIL, tense:present, aspect:simple, modality:none, polarity:negative, illocution:interrogative]

