/* Minimal NP/AP grammar for simple clauses. */

NP → proper_noun
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

NP → pro
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

NP → det N
{
  [HEAD:$HEAD, def:$def, number:$number, $Rest] ⊂ ↑;
  if (¬ $def)
    $def = true;
  if (¬ $number)
    $number = sg;

  // Keep determiner selection independent from synthesized noun features.
  // This avoids a deferred dependency while retaining the current test style.
  ↓1 = [def:$def, number:$number];
  ↓2 = [HEAD:$HEAD, number:$number, $Rest];
  ⇑ = ⇓1 U ⇓2 U [@_3];
}

// Plain noun realization. Magn/AntiMagn are handled by the lexicalized
// adjective + noun rule below.
N → common_noun
{
  [lexical_function:$LF] ⊂ ↑;
  if (¬ $LF)
    $LF = none;
  attest (($LF != magn) && ($LF != antimagn));
  ↓1 = ↑ U [lexical_function:$LF];
  ⇑ = ⇓1;
}

// Lexical-function modifier of a predicative noun:
// Magn(ATTENTION) -> close attention, AntiMagn(INTEREST) -> slight interest.
N → adj common_noun
{
  [lexical_function:magn|antimagn];
  ↓2 = ↑;
  [fixed_adj:$FIXED_ADJ] ⊂ ⇓2;
  ↓1 = $FIXED_ADJ U [lexical_function:none];
  ⇑ = ⇓2;
}

// Plain adjective realization.
AP → adj
{
  [lexical_function:$LF] ⊂ ↑;
  if (¬ $LF)
    $LF = none;
  attest (($LF != magn) && ($LF != antimagn));
  ↓1 = ↑ U [lexical_function:$LF];
  ⇑ = ⇓1;
}

// Lexical-function modifier of an adjective predicate:
// Magn(COLD) -> very cold, AntiMagn(DIFFICULT) -> somewhat difficult.
AP → adv adj
{
  [lexical_function:magn|antimagn];
  ↓2 = ↑;
  [fixed_adv:$FIXED_ADV] ⊂ ⇓2;
  ↓1 = $FIXED_ADV U [lexical_function:none];
  ⇑ = ⇓2;
}
