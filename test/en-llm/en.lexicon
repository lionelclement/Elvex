// FORM  POS  FEATURES;

// punctuation
"." strongPunct [punct:_dot_];
"?" strongPunct [punct:_int_];

// determiners
the det [def:true];
a det [def:indefinite, number:sg];
some det [def:indefinite, number:pl];

// Fixed determiner used only inside lexicalized expressions.
an fixed_det [fixed_form:_an_];

// proper nouns
John proper_noun [HEAD:JOHN, @_3s, @m, @human];
Mary proper_noun [HEAD:MARY, @_3s, @f, @human];
Sarah proper_noun [HEAD:SARAH, @_3s, @f, @human];
Peter proper_noun [HEAD:PETER, @_3s, @m, @human];

// personal pronouns — case is selected by the grammar
I pro [HEAD:pro, @_1s, case:nominative, @human];
me pro [HEAD:pro, @_1s, case:accusative, @human];
you pro [HEAD:pro, @_2s, case:nominative, @human];
you pro [HEAD:pro, @_2s, case:accusative, @human];
he pro [HEAD:pro, @_3s, @m, case:nominative, @human];
him pro [HEAD:pro, @_3s, @m, case:accusative, @human];
she pro [HEAD:pro, @_3s, @f, case:nominative, @human];
her pro [HEAD:pro, @_3s, @f, case:accusative, @human];
it pro [HEAD:pro, @_3s, case:nominative, @nonhuman];
it pro [HEAD:pro, @_3s, case:accusative, @nonhuman];
we pro [HEAD:pro, @_1p, case:nominative, @human];
us pro [HEAD:pro, @_1p, case:accusative, @human];
you pro [HEAD:pro, @_2p, case:nominative, @human];
you pro [HEAD:pro, @_2p, case:accusative, @human];
they pro [HEAD:pro, @_3p, case:nominative];
them pro [HEAD:pro, @_3p, case:accusative];

// do-support
do aux_do [aux_tense:present, SUBJECT:[@_12s]];
do aux_do [aux_tense:present, SUBJECT:[@p]];
does aux_do [aux_tense:present, SUBJECT:[@_3s]];
did aux_do [aux_tense:past];

// finite BE auxiliary
am aux_be [aux_tense:present, SUBJECT:[@_1s]];
are aux_be [aux_tense:present, SUBJECT:[@_2s]];
are aux_be [aux_tense:present, SUBJECT:[@p]];
is aux_be [aux_tense:present, SUBJECT:[@_3s]];
was aux_be [aux_tense:past, SUBJECT:[@_13s]];
were aux_be [aux_tense:past, SUBJECT:[@_2s]];
were aux_be [aux_tense:past, SUBJECT:[@p]];

// finite HAVE auxiliary
have aux_have [aux_tense:present, SUBJECT:[@_12s]];
have aux_have [aux_tense:present, SUBJECT:[@p]];
has aux_have [aux_tense:present, SUBJECT:[@_3s]];
had aux_have [aux_tense:past];

// future auxiliary and non-finite auxiliaries
will aux_future [];
be aux_be_base [];
have aux_have_base [];
been aux_been [];

// negation
not neg [];

// modals
can aux_modal [modality:can];
could aux_modal [modality:could];
may aux_modal [modality:may];
might aux_modal [modality:might];
must aux_modal [modality:must];
shall aux_modal [modality:shall];
should aux_modal [modality:should];
will aux_modal [modality:will];
would aux_modal [modality:would];

// prepositions selected by verbal valency
to prep [pcase:_to_];
on prep [pcase:_on_];
in prep [pcase:_in_];
at prep [pcase:_at_];

// Additional proper nouns.
Alice proper_noun [HEAD:ALICE, @_3s, @f, @human];
Bob proper_noun [HEAD:BOB, @_3s, @m, @human];
Emma proper_noun [HEAD:EMMA, @_3s, @f, @human];
David proper_noun [HEAD:DAVID, @_3s, @m, @human];
Michael proper_noun [HEAD:MICHAEL, @_3s, @m, @human];
Laura proper_noun [HEAD:LAURA, @_3s, @f, @human];

// Additional preposition required by TO_WAIT.
for prep [pcase:_for_];

// BEGIN GENERATED LARGE VOCABULARY
