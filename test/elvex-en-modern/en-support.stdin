// Support verb / Oper1 regression: DECISION -> make a decision
Axiom [HEAD:DECISION, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]

// Generalized Oper1 support constructions
Axiom [HEAD:ATTENTION, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
Axiom [HEAD:WALK, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
Axiom [HEAD:LOOK, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
Axiom [HEAD:ADVICE, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
Axiom [HEAD:BATH, i:[HEAD:JOHN], ii:NIL, iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]

// Oper2: semantic actant II is the surface subject.
Axiom [HEAD:ATTENTION, i:NIL, ii:[HEAD:JOHN], iii:NIL, lexical_function:oper2, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]

// Same semantic predicate and actants, different lexical-function mappings.
Axiom [HEAD:ATTENTION, i:[HEAD:JOHN], ii:[HEAD:MARY], iii:NIL, lexical_function:oper1, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
Axiom [HEAD:ATTENTION, i:[HEAD:JOHN], ii:[HEAD:MARY], iii:NIL, lexical_function:oper2, tense:present, aspect:simple, modality:none, polarity:positive, illocution:declarative]
