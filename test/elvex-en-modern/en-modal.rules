/* Core English modals with simple/perfect/progressive stacks. */

// modal simple — declarative, positive
ModalClause → NP aux_modal MainVP
{
  [HEAD:$HEAD, i:$SUBJECT, ii:$II, iii:$III, tense:$tense, aspect:simple, modality:$MODAL, polarity:positive, illocution:declarative, $Rest];
  ↓1 = $SUBJECT U [case:nominative];
  $SynthSubject = ⇓1;
  [person:$person, number:$number] ⊂ $SynthSubject;
  ↓2 = [modality:$MODAL, SUBJECT:$SynthSubject];
  ↓3 = [HEAD:$HEAD, ii:$II, iii:$III, SUBJECT:$SynthSubject, vtense:infinitive, $Rest];
  ⇑ = ⇓3;
}

// modal simple — declarative, negative
ModalClause → NP aux_modal neg MainVP
{
  [HEAD:$HEAD, i:$SUBJECT, ii:$II, iii:$III, tense:$tense, aspect:simple, modality:$MODAL, polarity:negative, illocution:declarative, $Rest];
  ↓1 = $SUBJECT U [case:nominative];
  $SynthSubject = ⇓1;
  [person:$person, number:$number] ⊂ $SynthSubject;
  ↓2 = [modality:$MODAL, SUBJECT:$SynthSubject];
  ↓3 = [];
  ↓4 = [HEAD:$HEAD, ii:$II, iii:$III, SUBJECT:$SynthSubject, vtense:infinitive, $Rest];
  ⇑ = ⇓4;
}

