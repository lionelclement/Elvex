// PHRASE → SYNTACTIC DESCRIPTION
//@unordered
S → NP VP dot
{
  [i:$i, $rest];
  ↓1 = $i;
  [number:$number, gender:$gender, person:$person, selectional_restriction:$selectional_restriction] ⊂ ⇓1;
  ↓2 = $rest U [SUBJ:[number:$number, gender:$gender, person:$person, selectional_restriction:$selectional_restriction]];
  ↓3 = [];
}

NP → det N
{
  ↓2 = ↑;
  ↓1 = ↑ U ⇓2;
  ⇑ = ⇓1 U ⇓2 U [@_3];
}

N → noun
{
  [mod:NIL];
  ↓1 = ↑;
  ⇑ = ⇓1;
}

VP → verb
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

@trace
VP → copverb adj
{
  ↓1 = ↑;
  [SUBJ:[number:$number, gender:$gender]] ⊂ ↑;
  [ADJ:$ADJ] ⊂ ⇓1;
  ↓2 = $ADJ U [number:$number, gender:$gender];
  ⇑ = ⇓1;
}