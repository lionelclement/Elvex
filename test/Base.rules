@trace
S → A B
{
  [i:$i, $rest];
  println [a:1];
  println [b:↑];
  println [c:↑.i.HEAD];
  println [d:↑.HEAD];
  println [e:⇓1];
  println [f:⇓1.isA];
  println [g:⇓1.HEAD];
  println [h:⇓1.LEMMA];
  println [i:⇓1.FORM];
  println [j:↑.ii];
  ↓1 = ↑;
  ↓2 = $i;
}

@trace
A → a 
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

@trace
B → b 
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}

