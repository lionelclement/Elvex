RENDRE_VISITE	verb	RENDRE	[obj:[HEAD:VISITE, @s, @no_det], prep_obj:[form:à], lex_func:none]
RENDRE_VISITE	verb	RENDRE	[obj:[HEAD:VISITE, @s, @det, @indef, mod:<[HEAD:LONG]>], prep_obj:[form:à], lex_func:magn]

PORTER_PLAINTE	verb	PORTER	[obj:[HEAD:PLAINTE, @s, @no_det], prep_obj:[form:contre], lex_func:none]
