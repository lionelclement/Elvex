LONG	adj	LONG	[pos:pre]

EXPOSER	verb	EXPOSER	[]

FAIRE_PEUR	verb	FAIRE	[obj:[HEAD:PEUR, @s, @no_det], prep_obj:[form:à], lex_func:none]
