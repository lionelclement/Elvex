"ses"   det [@p,  @poss, personPoss:three, numberPoss:sg];

"notre" det [@ms, @poss, personPoss:one,   numberPoss:pl];
"nos"   det [@p,  @poss, personPoss:one,   numberPoss:pl];

"votre" det [@ms, @poss, personPoss:two,   numberPoss:pl];
"vos"   det [@p,  @poss, personPoss:two,   numberPoss:pl];

"leur"  det [@ms, @poss, personPoss:three, numberPoss:pl];
"leurs" det [@p,  @poss, personPoss:three, numberPoss:pl];

"ce"    det [@ms, @dem];
"cette" det [@fs, @dem];
"ces"   det [@p,  @dem];

"de"	prep[form:de];
"à"	prep[form:à];
"par"	prep[form:par];
"pour"	prep[form:pour];
"sur"	prep[form:sur];
"avant"	prep[form:avant];
"après"	prep[form:après];
"avec"	prep[form:avec];
"contre"	prep[form:contre];
"dans"	prep[form:dans];

