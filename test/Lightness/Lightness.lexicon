"un"    det [@ms, @indef];
"une"   det [@fs, @indef];
"des"   det [@p,  @indef, qual:no];

"le"    det [@ms, @def];
"la"    det [@fs, @def];
"les"   det [@p,  @def, qual:no];

"mon"   det [@ms, @poss, personPoss:one,   numberPoss:sg];
"ma"    det [@fs, @poss, personPoss:one,   numberPoss:sg];
"mes"   det [@p,  @poss, personPoss:one,   numberPoss:sg];

"ton"   det [@ms, @poss, personPoss:two,   numberPoss:sg];
"ta"    det [@fs, @poss, personPoss:two,   numberPoss:sg];
"tes"   det [@p,  @poss, personPoss:two,   numberPoss:sg];

"son"   det [@ms, @poss, personPoss:three, numberPoss:sg];
