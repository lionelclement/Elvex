// @MACRO= FEATURES;
@s=	[number:singular];
@p=	[number:plural];
@m=	[gender:masc];
@f=	[gender:fem];
@ms= [@m, @s];
@mp= [@m, @p];
@fs= [@f, @s];
@fp= [@f, @p];
@_1=	[person:one];
@_2=	[person:two];
@_12=	[person:one|two];
@_3=	[person:three];
@_1s=	[@_1, @s];
@_2s=	[@_2, @s];
@_12s=	[@_12, @s];
@_3s=	[@_3, @s];
@_1p=	[@_1, @p];
@_2p=	[@_2, @p];
@_3p=	[@_3, @p];
@_3ms=	[@_3, @m, @s];
@_3fs=	[@_3, @f, @s];
@_3mp=	[@_3, @m, @p];
@_3fp=	[@_3, @f, @p];
@indicatif_present=	[MOOD:indicatif, TENSE:present];
@indicatif_imparfait=	[MOOD:indicatif, TENSE:imparfait];
@indicatif_passe_simple=	[MOOD:indicatif, TENSE:passe_simple];
@indicatif_futur_simple=	[MOOD:indicatif, TENSE:futur_simple];
@det=    [determiner:yes];
@no_det=    [determiner:no];
@mod=    [modifier:yes];
@no_mod=    [modifier:no];
@def   = [definite:yes, poss:no,  dem:no,  part:no];
@indef = [definite:no,  poss:no,  dem:no,  part:no];
@poss  = [definite:no,  poss:yes, dem:no,  part:no];
@dem   = [definite:no,  poss:no,  dem:yes, part:no];