@unordered
S → ADJ (ADJ) (ADJ) (ADJ) (ADJ) (ADJ) (ADJ) (ADJ)
{
  if (#2 && #3 && #4 && #5 && #6 && #7 && #8) {
    [mod:<$M1,$M2,$M3,$M4,$M5,$M6,$M7,$M8>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3; ↓4 = $M4;
    ↓5 = $M5; ↓6 = $M6; ↓7 = $M7; ↓8 = $M8;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank, ⇓4.rank,
              ⇓5.rank, ⇓6.rank, ⇓7.rank, ⇓8.rank>;
  } else if (#2 && #3 && #4 && #5 && #6 && #7) {
    [mod:<$M1,$M2,$M3,$M4,$M5,$M6,$M7>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3; ↓4 = $M4;
    ↓5 = $M5; ↓6 = $M6; ↓7 = $M7;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank, ⇓4.rank,
              ⇓5.rank, ⇓6.rank, ⇓7.rank>;
  } else if (#2 && #3 && #4 && #5 && #6) {
    [mod:<$M1,$M2,$M3,$M4,$M5,$M6>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3; ↓4 = $M4;
    ↓5 = $M5; ↓6 = $M6;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank,
              ⇓4.rank, ⇓5.rank, ⇓6.rank>;
  } else if (#2 && #3 && #4 && #5) {
    [mod:<$M1,$M2,$M3,$M4,$M5>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3;
    ↓4 = $M4; ↓5 = $M5;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank, ⇓4.rank, ⇓5.rank>;
  } else if (#2 && #3 && #4) {
    [mod:<$M1,$M2,$M3,$M4>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3; ↓4 = $M4;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank, ⇓4.rank>;
  } else if (#2 && #3) {
    [mod:<$M1,$M2,$M3>];
    ↓1 = $M1; ↓2 = $M2; ↓3 = $M3;
    order by <⇓1.rank, ⇓2.rank, ⇓3.rank>;
  } else if (#2) {
    [mod:<$M1,$M2>];
    ↓1 = $M1; ↓2 = $M2;
    order by <⇓1.rank, ⇓2.rank>;
  } else {
    [mod:<$M1>];
    ↓1 = $M1;
  }

  ⇑ = ↑;
}

ADJ → adj
{
  ↓1 = ↑;
  ⇑ = ⇓1;
}
