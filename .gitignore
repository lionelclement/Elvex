/data/examples/music/**/*.midi
/data/examples/music/**/*.pdf
/data/examples/music/**/*.lilypond.stamp
/data/examples/pop-music-didactic/**/*.ly
/data/examples/pop-music-didactic/**/*.midi
/data/examples/pop-music-didactic/**/*.pdf
/data/examples/pop-music-didactic/**/*.lilypond.stamp

