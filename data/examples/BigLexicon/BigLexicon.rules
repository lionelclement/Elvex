/* **************************************************
 * 
 ************************************************** */
@trace
Axiom → A B {
  ↓1 = ↑;
  [attrPattern:$attrPattern, attrMorpho:$attrMorpho, attrInteger:$attrInteger, attrString:$attrString] ⊂ ⇓1;
  ↓2 = [attrPattern:$attrPattern, attrMorpho:$attrMorpho, attrInteger:$attrInteger, attrString:$attrString];
}

/* **************************************************
 * 
 ************************************************** */
@trace
A → OPEN_CLASS_WORD_0 {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

/* **************************************************
 * 
 ************************************************** */
@trace
A → OPEN_CLASS_WORD_1 form {
  ↓1 = ↑;
  ⇑ = ⇓1;
  ↓2 = [FORM:"..."];
  
}

/* **************************************************
 * 
 ************************************************** */
@trace
B → CLOSED_CLASS_WORD {
  ↓1 = ↑;
  ⇑ = ⇓1;
}
