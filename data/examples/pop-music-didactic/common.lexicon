"r4. " REST [dur:"3/8"];
"r2 " REST [dur:"1/2"];
"r2. " REST [dur:"3/4"];
"r1 " REST [dur:"1/1"];
"\\tuplet 3/2 { " TUPLET3_OPEN [];
"} " TUPLET_CLOSE [];
"( " SLUR_OPEN [];
") " SLUR_CLOSE [];
"-. " STACCATO [];
"~ " TIE [];

// Terminaux d’accords de piano. root_pc est la fondamentale ; quality vaut maj/min/dim.
// La grammaire calcule root_pc depuis la tonalité, ce qui rend ces entrées réutilisables dans toutes les tonalités.
// accidental_policy:sharp
// accidental_policy:flat


