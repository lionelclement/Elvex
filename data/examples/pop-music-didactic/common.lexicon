// =============================================================================
// common.lexicon
// =============================================================================
// Lexique commun : syntaxe LilyPond, en-têtes, portées, clés, tempo, mesure, dynamiques, notes, silences et instruments MIDI.
//
// -----------------------------------------------------------------------------
// COMMENTAIRES DE LECTURE DU LEXIQUE
// -----------------------------------------------------------------------------
// Syntaxe générale d'une entrée lexicale :
//
//   "texte LilyPond" CATEGORIE [traits];
//
// Quand une règle produit CATEGORIE avec des traits compatibles, Elvex émet le
// texte LilyPond entre guillemets. Les traits entre crochets servent à choisir
// la bonne entrée : hauteur, durée, mode, dynamique, instrument MIDI, etc.
// -----------------------------------------------------------------------------

"" EMPTY [];
"\\version \"2.26.0\"\n" VERSION [];
"\\paper {\n  tagline = ##f\n}\n" PAPER_NO_TAGLINE [];

"\\header {\n" HEADER_OPEN [];
"  title = \"$title\"\n" TITLE [title:$title];
"  composer = \"$composer\"\n" COMPOSER [composer:$composer];
"}\n" HEADER_CLOSE [];

"\\score {\n" SCORE_OPEN [];
"}\n" SCORE_CLOSE [];

// Conteneur de musique séquentielle utilisé par form:scales. Contrairement à << >>, il fait
// apparaître les portées d’exercices les unes après les autres au lieu de simultanément.
"{\n" SEQ_OPEN [];
"}\n" SEQ_CLOSE [];

"<<\n" PAR_OPEN [];
">>\n" PAR_CLOSE [];

// Conteneurs et clés de piano. Ils sont utilisés par les nouveaux routages piano_solo et
// flute_piano_duet dans music.rules.
"  \\new PianoStaff <<\n" PIANO_OPEN [];
"  >>\n" PIANO_CLOSE [];
"    \\new Staff = \"right\" {\n" PIANO_RH_OPEN [];
"    \\new Staff = \"left\" {\n" PIANO_LH_OPEN [];
"    \\clef treble\n" CLEF_TREBLE [];
"    \\clef bass\n" CLEF_BASS [];
"    \\clef alto\n" CLEF_ALTO [];
"    \\clef \"treble_8\"\n" CLEF_TREBLE_8 [];
"    \\clef percussion\n" CLEF_PERCUSSION [];

"  \\new Staff {\n" STAFF_OPEN [];
"  }\n" STAFF_CLOSE [];

"    \\set Staff.instrumentName = \"$instrument_name\"\n" INSTRUMENT_NAME [instrument_name:$instrument_name];
"    \\set Staff.midiInstrument = \"$midi_instrument\"\n" MIDI_INSTRUMENT [midi_instrument:$midi_instrument];
"    \\tempo 4 = $bpm\n" TEMPO [bpm:$bpm];
"    \\key $tonic \\$mode\n" KEY [tonic:$tonic, mode:$mode];
"    \\time $num/$den\n\n" TIME [num:$num, den:$den];

"\n" NL [];
"    " TAB [];

// Saut de système forcé utilisé par form:scales pour que chaque exercice commence au
// début d’une nouvelle ligne ou d’un nouveau système au lieu de continuer dans le même système.
"  \\break\n" SCALE_SECTION_BREAK [];


"  \\layout { }\n" LAYOUT [];
"  \\midi { }\n" MIDI [];

// Dynamiques : attachées à des espaces de durée nulle pour éviter les avertissements LilyPond.
"    s1*0\\pp\n" DYNAMIC [dynamic:pp];
"    s1*0\\p\n" DYNAMIC [dynamic:p];
"    s1*0\\mp\n" DYNAMIC [dynamic:mp];
"    s1*0\\mf\n" DYNAMIC [dynamic:mf];
"    s1*0\\f\n" DYNAMIC [dynamic:f];
"    s1*0\\ff\n" DYNAMIC [dynamic:ff];

"|\n" BARLINE [];
"\\bar \"|.\"\n" FINAL_BARLINE [];

// Terminaux de notes. pc est la classe de hauteur absolue ; octave suit la convention existante du projet.
// accidental_policy:sharp
"c16 " NOTE [pc:0, octave:3, dur:"1/16", accidental_policy:sharp];
"c8 " NOTE [pc:0, octave:3, dur:"1/8", accidental_policy:sharp];
"c8. " NOTE [pc:0, octave:3, dur:"3/16", accidental_policy:sharp];
"c4 " NOTE [pc:0, octave:3, dur:"1/4", accidental_policy:sharp];
"c4. " NOTE [pc:0, octave:3, dur:"3/8", accidental_policy:sharp];
