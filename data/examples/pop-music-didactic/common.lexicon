// Étiquette de section utilisée dans une seule portée continue pour form:scales.
// instrumentName et shortInstrumentName sont tous deux définis pour que l’étiquette reste
// visible after LilyPond system breaks.
"    \\set Staff.instrumentName = \"$section_label\"\n    \\set Staff.shortInstrumentName = \"$section_label\"\n" SCALE_SECTION_LABEL [section_label:$section_label];

// Articulation pour les sons longs dans form:scales.
"\\fermata " FERMATA [];

// Marque de respiration utilisée entre les grands groupes dans les études de gammes de flûte.
"  \\breathe\n" SCALE_BREATH [];

