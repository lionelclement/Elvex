// Grammar fragment
S → ADJs {
  ↓1 = ↑;
}

ADJs → ADJ {
  [mod:<$Uniq>];
  ↓1 = $Uniq;
  ⇑ = [rank:⇓1.rank];
}

ADJs → ADJs ADJ {
  [mod:<$Head :: $Tail>];
  ↓1 = [mod:$Tail];
  ↓2 = $Head;
  order 1, 2 by ⇓.rank;
  $minRank = min(⇓1.rank, ⇓2.rank);
  ⇑ = [rank:$minRank];
}

ADJ → adj {
  ↓1 = ↑;
  ⇑ = ⇓1;
}

