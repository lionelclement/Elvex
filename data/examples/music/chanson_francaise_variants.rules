// =============================================================================
// chanson_francaise_variants.rules
// =============================================================================
// Variantes de chanson française : lyrique, parlée, nostalgique, refrain hook. Chaque variante garde la logique couplet/refrain mais change les motifs.
//

// -----------------------------------------------------------------------------
// Chanson française : variantes mélodiques explicites
// -----------------------------------------------------------------------------
// Extension additive. Elle ne modifie pas la forme originale
//   chanson_francaise_couplet_refrain
// Les nouveaux inputs peuvent choisir une famille mélodique spécifique en utilisant l’une de ces formes :
//   chanson_francaise_couplet_refrain_lyrique
//   chanson_francaise_couplet_refrain_parle
//   chanson_francaise_couplet_refrain_nostalgique
//   chanson_francaise_couplet_refrain_refrain_hook
//
// La guitare réutilise le CHANSON_GUITAR_FORM stable de chanson_francaise.rules.
// Seule la ligne de voix/mélodie change.

@withoutSpaces
MUSICAL_FORM → CHANSON_VOICE_FORM_LYRIQUE
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_lyrique]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_lyrique]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CHANSON_VOICE_FORM_PARLE
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_parle]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_parle]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CHANSON_VOICE_FORM_NOSTALGIQUE
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_nostalgique]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_nostalgique]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CHANSON_VOICE_FORM_REFRAIN_HOOK
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_refrain_hook]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_refrain_hook]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

// Même architecture de 72 mesures que la forme de chanson originale.
@withoutSpaces
CHANSON_VOICE_FORM_LYRIQUE → CHV_LYR_INTRO_4 CHV_LYR_VERSE1_16 CHV_LYR_CHORUS_16 CHV_LYR_VERSE2_16 CHV_LYR_FINAL_CHORUS_16 CHV_LYR_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[last_function:tonic, cadence:authentic]; }
@withoutSpaces
CHANSON_VOICE_FORM_PARLE → CHV_PAR_INTRO_4 CHV_PAR_VERSE1_16 CHV_PAR_CHORUS_16 CHV_PAR_VERSE2_16 CHV_PAR_FINAL_CHORUS_16 CHV_PAR_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[last_function:tonic, cadence:authentic]; }
@withoutSpaces
CHANSON_VOICE_FORM_NOSTALGIQUE → CHV_NOS_INTRO_4 CHV_NOS_VERSE1_16 CHV_NOS_CHORUS_16 CHV_NOS_VERSE2_16 CHV_NOS_FINAL_CHORUS_16 CHV_NOS_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[last_function:tonic, cadence:authentic]; }
@withoutSpaces
CHANSON_VOICE_FORM_REFRAIN_HOOK → CHV_HOOK_INTRO_4 CHV_HOOK_VERSE1_16 CHV_HOOK_CHORUS_16 CHV_HOOK_VERSE2_16 CHV_HOOK_FINAL_CHORUS_16 CHV_HOOK_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[last_function:tonic, cadence:authentic]; }

