CT_PULSE_7_ROLL → BAR4_STACCATO
{ ↓1=↑ ∪ [motif:[o1:0,o2:0,o3:7,o4:7], rhythm:[r1:"1/8",r2:"1/8",r3:"1/8",r4:"1/8"]]; ⇑=⇓1; }
@withoutSpaces
CT_PULSE_8_STOP → BAR2
{ ↓1=↑ ∪ [motif:[o1:0,o2:0], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
