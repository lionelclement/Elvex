@withoutSpaces
CT_ACCENT_8_TONIC → BAR2
{ ↓1=↑ ∪ [motif:[o1:0,o2:0], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }

// -----------------------------------------------------------------------------
// 7. Basse : fondamentale fonctionnelle. Oom-pah, mais jamais chromatique.
// -----------------------------------------------------------------------------

@withoutSpaces
CT_BASS_1_I → BAR2
{ ↓1=↑ ∪ [motif:[o1:0,o2:7], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CT_BASS_2_V → BAR2
{ ↓1=↑ ∪ [motif:[o1:7,o2:14], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
