// 5. Cuivres aigus : harmonie claire, valeurs longues, pas de doublure continue.
// -----------------------------------------------------------------------------

@withoutSpaces
CT_BRASS_1_TONIC → BAR2
{ ↓1=↑ ∪ [motif:[o1:7,o2:12], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CT_BRASS_2_DOMINANT → BAR2
