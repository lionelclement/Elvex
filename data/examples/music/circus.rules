@withoutSpaces
CT_BRASS_6_PREDOM → BAR2
{ ↓1=↑ ∪ [motif:[o1:9,o2:11], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CT_BRASS_7_DOMINANT → BAR2
{ ↓1=↑ ∪ [motif:[o1:7,o2:11], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
CT_BRASS_8_TONIC → BAR2
{ ↓1=↑ ∪ [motif:[o1:12,o2:0], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }

// -----------------------------------------------------------------------------
// 6. Trombone / accents : afterbeats et préparation cadentielle.
// -----------------------------------------------------------------------------

@withoutSpaces
CT_ACCENT_1_AFTERBEAT → BAR4_REST_AFTER_1
{ ↓1=↑ ∪ [motif:[o1:0,o2:7,o3:0], rhythm:[r1:"1/8",rr:"1/8",r2:"1/8",r3:"1/8"]]; ⇑=⇓1; }
CT_ACCENT_2_REST → CIRCUS_REST_2_4 { ↓1=↑; ⇑=⇓1; }
@withoutSpaces
CT_ACCENT_3_AFTERBEAT → BAR4_REST_AFTER_1
{ ↓1=↑ ∪ [motif:[o1:0,o2:4,o3:7], rhythm:[r1:"1/8",rr:"1/8",r2:"1/8",r3:"1/8"]]; ⇑=⇓1; }
@withoutSpaces
CT_ACCENT_4_DOM_PUNCT → BAR2
{ ↓1=↑ ∪ [motif:[o1:7,o2:7], rhythm:[r1:"1/4",r2:"1/4"]]; ⇑=⇓1; }
@withoutSpaces
