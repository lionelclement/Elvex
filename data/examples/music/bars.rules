// =============================================================================
// bars.rules
// =============================================================================
// Briques de bas niveau : BAR1, BAR2, BAR4, BAR6, BAR8 et variantes avec silences. Ces règles transforment les traits de hauteur/durée en notes LilyPond via le lexique.
//

// --- Mesures de bas niveau --------------------------------------------------
// Ces règles réalisent les degrés sous forme de classes de hauteurs absolues et synthétisent
// les premières/dernières notes afin que les règles parentes puissent continuer depuis le résultat produit.


@withoutSpaces
// -----------------------------------------------------------------------------
// BAR* : patrons de mesures.
// BAR1 contient une note longue, BAR4 quatre événements, BAR8 huit événements,
// etc. Les règles de matériau choisissent un BAR*, puis les traits de hauteur
// et durée sont réalisés par NOTE/REST/CHORD dans les lexiques.
// -----------------------------------------------------------------------------
BAR1 → TAB NOTE BARLINE
{
  // Une mesure complète en 4/4 écrite comme une seule ronde.
  // Utilisé surtout pour la note finale de basse de la main gauche du piano.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a], rhythm:[r1:$r1]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a;
  $oct1_shift = floor($pc1_abs / 12);
  $pc1 = $pc1_abs % 12;
  $o1 = $octave + $oct1_shift;
  ↓1=[];
  ↓2=[pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3=[];
  ⇑ = [first_offset:$a, last_offset:$a, first_pc:$pc1, last_pc:$pc1];
}


@withoutSpaces
BAR2 → TAB NOTE NOTE BARLINE
{
  // Une mesure divisée en deux événements, généralement deux blanches.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a, o2:$b], rhythm:[r1:$r1, r2:$r2]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  ↓1=[];
  ↓2=[pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3=[pc:$pc2, octave:$o2, dur:$r2, accidental_policy:$accidental_policy];
  ↓4=[];
  ⇑ = [first_offset:$a, last_offset:$b, first_pc:$pc1, last_pc:$pc2];
}

@withoutSpaces
BAR4 → TAB NOTE NOTE NOTE NOTE BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a, o2:$b, o3:$c, o4:$d],
   rhythm:[r1:$r1, r2:$r2, r3:$r3, r4:$r4]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  $pc3_abs = $tonic_pc + $c; $oct3_shift = floor($pc3_abs / 12); $pc3 = $pc3_abs % 12; $o3 = $octave + $oct3_shift;
  $pc4_abs = $tonic_pc + $d; $oct4_shift = floor($pc4_abs / 12); $pc4 = $pc4_abs % 12; $o4 = $octave + $oct4_shift;
  ↓1 = [];
  ↓2 = [pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3 = [pc:$pc2, octave:$o2, dur:$r2, accidental_policy:$accidental_policy];
  ↓4 = [pc:$pc3, octave:$o3, dur:$r3, accidental_policy:$accidental_policy];
  ↓5 = [pc:$pc4, octave:$o4, dur:$r4, accidental_policy:$accidental_policy];
  ↓6 = [];
  ⇑ = [first_offset:$a, last_offset:$d, first_pc:$pc1, last_pc:$pc4];
}

@withoutSpaces
BAR6 → TAB NOTE NOTE NOTE NOTE NOTE NOTE BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a, o2:$b, o3:$c, o4:$d, o5:$e, o6:$f],
   rhythm:[r1:$r1, r2:$r2, r3:$r3, r4:$r4, r5:$r5, r6:$r6]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  $pc3_abs = $tonic_pc + $c; $oct3_shift = floor($pc3_abs / 12); $pc3 = $pc3_abs % 12; $o3 = $octave + $oct3_shift;
  $pc4_abs = $tonic_pc + $d; $oct4_shift = floor($pc4_abs / 12); $pc4 = $pc4_abs % 12; $o4 = $octave + $oct4_shift;
  $pc5_abs = $tonic_pc + $e; $oct5_shift = floor($pc5_abs / 12); $pc5 = $pc5_abs % 12; $o5 = $octave + $oct5_shift;
  $pc6_abs = $tonic_pc + $f; $oct6_shift = floor($pc6_abs / 12); $pc6 = $pc6_abs % 12; $o6 = $octave + $oct6_shift;
  ↓1 = [];
  ↓2 = [pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3 = [pc:$pc2, octave:$o2, dur:$r2, accidental_policy:$accidental_policy];
  ↓4 = [pc:$pc3, octave:$o3, dur:$r3, accidental_policy:$accidental_policy];
  ↓5 = [pc:$pc4, octave:$o4, dur:$r4, accidental_policy:$accidental_policy];
  ↓6 = [pc:$pc5, octave:$o5, dur:$r5, accidental_policy:$accidental_policy];
  ↓7 = [pc:$pc6, octave:$o6, dur:$r6, accidental_policy:$accidental_policy];
  ↓8 = [];
  ⇑ = [first_offset:$a, last_offset:$f, first_pc:$pc1, last_pc:$pc6];
}

@withoutSpaces
BAR8 → TAB NOTE NOTE NOTE NOTE NOTE NOTE NOTE NOTE BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a, o2:$b, o3:$c, o4:$d, o5:$e, o6:$f, o7:$g, o8:$h],
   rhythm:[r1:$r1, r2:$r2, r3:$r3, r4:$r4, r5:$r5, r6:$r6, r7:$r7, r8:$r8]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  $pc3_abs = $tonic_pc + $c; $oct3_shift = floor($pc3_abs / 12); $pc3 = $pc3_abs % 12; $o3 = $octave + $oct3_shift;
  $pc4_abs = $tonic_pc + $d; $oct4_shift = floor($pc4_abs / 12); $pc4 = $pc4_abs % 12; $o4 = $octave + $oct4_shift;
  $pc5_abs = $tonic_pc + $e; $oct5_shift = floor($pc5_abs / 12); $pc5 = $pc5_abs % 12; $o5 = $octave + $oct5_shift;
  $pc6_abs = $tonic_pc + $f; $oct6_shift = floor($pc6_abs / 12); $pc6 = $pc6_abs % 12; $o6 = $octave + $oct6_shift;
  $pc7_abs = $tonic_pc + $g; $oct7_shift = floor($pc7_abs / 12); $pc7 = $pc7_abs % 12; $o7 = $octave + $oct7_shift;
  $pc8_abs = $tonic_pc + $h; $oct8_shift = floor($pc8_abs / 12); $pc8 = $pc8_abs % 12; $o8 = $octave + $oct8_shift;
  ↓1 = [];
  ↓2 = [pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3 = [pc:$pc2, octave:$o2, dur:$r2, accidental_policy:$accidental_policy];
  ↓4 = [pc:$pc3, octave:$o3, dur:$r3, accidental_policy:$accidental_policy];
  ↓5 = [pc:$pc4, octave:$o4, dur:$r4, accidental_policy:$accidental_policy];
  ↓6 = [pc:$pc5, octave:$o5, dur:$r5, accidental_policy:$accidental_policy];
  ↓7 = [pc:$pc6, octave:$o6, dur:$r6, accidental_policy:$accidental_policy];
  ↓8 = [pc:$pc7, octave:$o7, dur:$r7, accidental_policy:$accidental_policy];
  ↓9 = [pc:$pc8, octave:$o8, dur:$r8, accidental_policy:$accidental_policy];
  ↓10 = [];
  ⇑ = [first_offset:$a, last_offset:$h, first_pc:$pc1, last_pc:$pc8];
}


// -----------------------------------------------------------------------------
// Dessins formels supplémentaires.
// Ces formes ne renomment pas simplement rounded_binary : chaque forme possède un plan
// de sections distinct et des fonctions musicales différentes.
//   - ternary: A - contrasting B - A return - coda.
//   - theme_and_variations: theme - rhythmic/ornamental variation - register variation - coda.
//   - minuet_trio: dance-like 3/4 minuet, trio, da capo-style return, coda.
// -----------------------------------------------------------------------------

@withoutSpaces
MUSICAL_FORM → FLUTE1_TERNARY_CONTROLLED
{ [role:flute1, form:ternary]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE2_TERNARY_CONTROLLED
{ [role:flute2, form:ternary]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE1_THEME_AND_VARIATIONS_CONTROLLED
{ [role:flute1, form:theme_and_variations]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE2_THEME_AND_VARIATIONS_CONTROLLED
{ [role:flute2, form:theme_and_variations]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE1_MINUET_TRIO
{ [role:flute1, form:minuet_trio]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → FLUTE2_MINUET_TRIO
{ [role:flute2, form:minuet_trio]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

// --- Forme ternaire ----------------------------------------------------------
// La forme ternaire est plus courte et plus claire que le binaire arrondi : A, B contrastant,
// retour de A, puis coda. La section B fait quatre mesures et module davantage.

@withoutSpaces
FLUTE1_TERNARY → FLUTE1_A_PERIOD FLUTE1_TERNARY_B FLUTE1_A_RETURN FLUTE1_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$a_end] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a_end, section:b];
  [home_tonic_pc:$home, last_offset:$b_end] ⊂ ⇓2;
  ↓3 = [tonic_pc:$home, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b_end, section:return];
  [last_function:$ret] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$ret];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE2_TERNARY → FLUTE2_A_SUPPORT FLUTE2_TERNARY_B FLUTE2_A_RETURN FLUTE2_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$a_end] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a_end, section:b];
  [home_tonic_pc:$home, last_offset:$b_end] ⊂ ⇓2;
  ↓3 = [tonic_pc:$home, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b_end, section:return];
  [last_function:$ret] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$ret];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE1_TERNARY_B → FL1_MODULATING_MOTIF FL1_DOMINANT_KEY_MOTIF FL1_SEQUENCE_MOTIF FL1_DOMINANT_KEY_CADENCE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  $new_key_abs = $tonic_pc + 7;
  $new_key_pc = $new_key_abs % 12;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy];
  [last_offset:$m1] ⊂ ⇓1;
  ↓2 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m1];
  [last_offset:$m2] ⊂ ⇓2;
  ↓3 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m2];
  [last_function:$f3] ⊂ ⇓3;
  ↓4 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$f3];
  ⇑ = [home_tonic_pc:$tonic_pc, current_key_pc:$new_key_pc, last_offset:7, last_function:dominant, tension:high];
}

@withoutSpaces
FLUTE2_TERNARY_B → FL2_MODULATING_SUPPORT FL2_DOMINANT_PEDAL FL2_SEQUENCE_SUPPORT FL2_DOMINANT_SUPPORT
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  $new_key_abs = $tonic_pc + 7;
  $new_key_pc = $new_key_abs % 12;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy];
  [last_offset:$m1] ⊂ ⇓1;
  ↓2 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m1];
  [last_offset:$m2] ⊂ ⇓2;
  ↓3 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m2];
  [last_function:$f3] ⊂ ⇓3;
  ↓4 = [tonic_pc:$new_key_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$f3];
  ⇑ = [home_tonic_pc:$tonic_pc, current_key_pc:$new_key_pc, last_offset:7, last_function:dominant, tension:high];
}

// --- Thème et variations -----------------------------------------------------
// Cette forme modifie le traitement du même matériau au lieu de simplement
// ajouter un B contrastant : d’abord une variation ornée, puis une variation de registre.

@withoutSpaces
FLUTE1_THEME_AND_VARIATIONS → FLUTE1_A_PERIOD FLUTE1_A_VARIATION FLUTE1_REGISTER_VARIATION FLUTE1_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$theme_end] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$theme_end, variation:ornamented];
  [last_offset:$var1_end] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$var1_end, variation:register];
  [last_function:$var2_function] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$var2_function];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE2_THEME_AND_VARIATIONS → FLUTE2_A_SUPPORT FLUTE2_A_VARIATION FLUTE2_REGISTER_VARIATION FLUTE2_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$theme_end] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$theme_end, variation:ornamented];
  [last_offset:$var1_end] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$var1_end, variation:register];
  [last_function:$var2_function] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$var2_function];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE1_REGISTER_VARIATION → FL1_HIGH_REGISTER_MOTIF FL1_ECHO_MOTIF FL1_SEQUENCE_MOTIF FL1_AUTHENTIC_CADENCE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$opening] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$m1] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m1];
  [last_offset:$m2] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m2];
  [last_function:$f3, tension:$t3] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$f3, previous_tension:$t3];
  ⇑ = ⇓4;
}

@withoutSpaces
FLUTE2_REGISTER_VARIATION → FL2_MOBILE_COUNTERLINE FL2_ECHO_SUPPORT FL2_DOMINANT_SUPPORT FL2_TONIC_RESOLUTION
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$opening] ⊂ ↑;
  ↓1 = ↑;
  [last_offset:$m1] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$m1];
  [last_function:$f2] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$f2];
  [last_function:$f3, tension:$t3] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, previous_function:$f3, previous_tension:$t3];
  ⇑ = ⇓4;
}

@withoutSpaces
FL1_HIGH_REGISTER_MOTIF → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
        motif:[o1:7, o2:9, o3:12, o4:14, o5:12, o6:9],
        rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/4", r5:"1/8", r6:"1/8"]];
  [last_offset:$last] ⊂ ⇓1;
  ⇑ = [last_offset:$last, last_function:dominant, tension:medium];
}

@withoutSpaces
FL1_ECHO_MOTIF → BAR6
{
  [opening_offset:$opening] ⊂ ↑;
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
        motif:[o1:$opening, o2:7, o3:5, o4:4, o5:2, o6:4],
        rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/8", r5:"1/8", r6:"1/4"]];
  [last_offset:$last] ⊂ ⇓1;
  ⇑ = [last_offset:$last, last_function:tonic, tension:low];
}

@withoutSpaces
FL2_MOBILE_COUNTERLINE → BAR6
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
        motif:[o1:4, o2:7, o3:9, o4:7, o5:5, o6:4],
        rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/4", r5:"1/8", r6:"1/8"]];
  [last_offset:$last] ⊂ ⇓1;
  ⇑ = [last_offset:$last, last_function:counterline, tension:medium];
}

@withoutSpaces
FL2_ECHO_SUPPORT → BAR4
{
  [opening_offset:$opening] ⊂ ↑;
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
        motif:[o1:$opening, o2:7, o3:4, o4:2],
        rhythm:[r1:"1/2", r2:"1/4", r3:"1/8", r4:"1/8"]];
  [last_offset:$last] ⊂ ⇓1;
  ⇑ = [last_offset:$last, last_function:tonic, tension:low];
}

// --- Menuet et trio ----------------------------------------------------------
// minuet_trio est volontairement différent : il exige une mesure en 3/4, utilise BAR3,
// et produit une phrase de danse plutôt que le matériau périodique en 4/4.

@withoutSpaces
FLUTE1_MINUET_TRIO → FLUTE1_MINUET_A FLUTE1_MINUET_B FLUTE1_TRIO_A FLUTE1_TRIO_B FLUTE1_MINUET_DA_CAPO FLUTE1_MINUET_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; [last_offset:$a] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a]; [last_offset:$b] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b]; [last_offset:$c] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$c]; [last_offset:$d] ⊂ ⇓4;
  ↓5 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$d]; [last_offset:$e] ⊂ ⇓5;
  ↓6 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$e];
  ⇑ = ⇓6;
}

@withoutSpaces
FLUTE2_MINUET_TRIO → FLUTE2_MINUET_A FLUTE2_MINUET_B FLUTE2_TRIO_A FLUTE2_TRIO_B FLUTE2_MINUET_DA_CAPO FLUTE2_MINUET_CODA
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  ↓1 = ↑; [last_offset:$a] ⊂ ⇓1;
  ↓2 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$a]; [last_offset:$b] ⊂ ⇓2;
  ↓3 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$b]; [last_offset:$c] ⊂ ⇓3;
  ↓4 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$c]; [last_offset:$d] ⊂ ⇓4;
  ↓5 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy, opening_offset:$d]; [last_offset:$e] ⊂ ⇓5;
