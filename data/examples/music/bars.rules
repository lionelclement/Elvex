  $pc6_abs = $tonic_pc + $f; $oct6_shift = floor($pc6_abs / 12); $pc6 = $pc6_abs % 12; $o6 = $octave + $oct6_shift;
  $pc7_abs = $tonic_pc + $g; $oct7_shift = floor($pc7_abs / 12); $pc7 = $pc7_abs % 12; $o7 = $octave + $oct7_shift;
  ↓1=[];
  ↓2=[pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
