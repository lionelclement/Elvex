@withoutSpaces
CHORD_BAR1 → TAB CHORD BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   root:$root, quality:$quality, dur:$dur] ⊂ ↑;
  $pc_abs = $tonic_pc + $root; $oct_shift = floor($pc_abs / 12); $pc = $pc_abs % 12; $o = $octave + $oct_shift;
  ↓1 = [];
  ↓2 = [root_pc:$pc, octave:$o, dur:$dur, quality:$quality, accidental_policy:$accidental_policy];
  ↓3 = [];
  ⇑ = [first_root:$root, last_root:$root, first_pc:$pc, last_pc:$pc];
}


// --- Mesures supplémentaires pour études de gammes --------------------------
// BAR1_FERMATA est utilisé pour les sons tenus : une ronde avec point d’orgue.
@withoutSpaces
BAR1_FERMATA → TAB NOTE FERMATA BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a], rhythm:[r1:$r1]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a;
  $oct1_shift = floor($pc1_abs / 12);
  $pc1 = $pc1_abs % 12;
  $o1 = $octave + $oct1_shift;
  ↓1=[];
  ↓2=[pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3=[];
  ↓4=[];
  ⇑ = [first_offset:$a, last_offset:$a, first_pc:$pc1, last_pc:$pc1];
}

// BAR7 réalise une noire suivie de six croches : 4 + 6×8 = 4/4.
@withoutSpaces
BAR7 → TAB NOTE NOTE NOTE NOTE NOTE NOTE NOTE BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   motif:[o1:$a, o2:$b, o3:$c, o4:$d, o5:$e, o6:$f, o7:$g],
   rhythm:[r1:$r1, r2:$r2, r3:$r3, r4:$r4, r5:$r5, r6:$r6, r7:$r7]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  $pc3_abs = $tonic_pc + $c; $oct3_shift = floor($pc3_abs / 12); $pc3 = $pc3_abs % 12; $o3 = $octave + $oct3_shift;
  $pc4_abs = $tonic_pc + $d; $oct4_shift = floor($pc4_abs / 12); $pc4 = $pc4_abs % 12; $o4 = $octave + $oct4_shift;
  $pc5_abs = $tonic_pc + $e; $oct5_shift = floor($pc5_abs / 12); $pc5 = $pc5_abs % 12; $o5 = $octave + $oct5_shift;
  $pc6_abs = $tonic_pc + $f; $oct6_shift = floor($pc6_abs / 12); $pc6 = $pc6_abs % 12; $o6 = $octave + $oct6_shift;
  $pc7_abs = $tonic_pc + $g; $oct7_shift = floor($pc7_abs / 12); $pc7 = $pc7_abs % 12; $o7 = $octave + $oct7_shift;
  ↓1=[];
  ↓2=[pc:$pc1, octave:$o1, dur:$r1, accidental_policy:$accidental_policy];
  ↓3=[pc:$pc2, octave:$o2, dur:$r2, accidental_policy:$accidental_policy];
  ↓4=[pc:$pc3, octave:$o3, dur:$r3, accidental_policy:$accidental_policy];
  ↓5=[pc:$pc4, octave:$o4, dur:$r4, accidental_policy:$accidental_policy];
  ↓6=[pc:$pc5, octave:$o5, dur:$r5, accidental_policy:$accidental_policy];
  ↓7=[pc:$pc6, octave:$o6, dur:$r6, accidental_policy:$accidental_policy];
  ↓8=[pc:$pc7, octave:$o7, dur:$r7, accidental_policy:$accidental_policy];
  ↓9=[];
  ⇑ = [first_offset:$a, last_offset:$g, first_pc:$pc1, last_pc:$pc7];
}

// Accord en ronde avec point d’orgue pour les sections de sons tenus au piano.
@withoutSpaces
CHORD_BAR1_FERMATA → TAB CHORD FERMATA BARLINE
{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   root:$root, quality:$quality, dur:$dur] ⊂ ↑;
  $root_abs = $tonic_pc + $root;
  $root_pc = $root_abs % 12;
  $oct_shift = floor($root_abs / 12);
  $root_oct = $octave + $oct_shift;
  ↓1=[];
  ↓2=[root_pc:$root_pc, root_octave:$root_oct, quality:$quality, dur:$dur, accidental_policy:$accidental_policy];
  ↓3=[];
  ↓4=[];
  ⇑ = [last_function:chord_fermata];
}


// BAR7_SLURRED est la version liée de BAR7 : la première note ouvre la liaison,
// la dernière la ferme. Même profil de durée : noire + six croches = 4/4.
