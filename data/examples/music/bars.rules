{
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy] ⊂ ↑;
  $low_octave = $octave - 1;
  $r = rand() % 100;
  if ($r < 55) {
    ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
          motif:[o1:0, o2:2, o3:4, o4:7], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/4"]];
  } else if ($r < 72) {
    // Mouvement de menuet dans le registre de do grave.
    ↓1 = [tonic_pc:$tonic_pc, octave:$low_octave, accidental_policy:$accidental_policy,
          motif:[o1:0, o2:2, o3:4, o4:7], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/4"]];
  } else if ($r < 88) {
    // Montée par broderie chromatique inférieure. En ré majeur : ré-mi-fa naturel-fa dièse.
    ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
          motif:[o1:0, o2:2, o3:3, o4:4], rhythm:[r1:"1/8", r2:"1/8", r3:"1/4", r4:"1/4"]];
  } else {
    // Quarte augmentée menant à une couleur de dominante. En ré majeur : mi-fa dièse-sol dièse-la.
    ↓1 = [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
          motif:[o1:2, o2:4, o3:6, o4:7], rhythm:[r1:"1/4", r2:"1/8", r3:"1/8", r4:"1/4"]];
  }
  [last_offset:$last] ⊂ ⇓1; ⇑ = [last_offset:$last, last_function:tonic, tension:low];
}

