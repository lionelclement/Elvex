// --- Mesures d’accords de piano de bas niveau -------------------------------
// Les terminaux CHORD sont définis dans music.lexicon. Ces règles calculent la fondamentale de chaque accord
// à partir de tonic_pc + un décalage diatonique/chromatique, puis demandent au lexique un accord
// avec la qualité, la durée, l’octave et la politique d’altérations demandées.


@withoutSpaces
CHORD_BAR3 → TAB CHORD CHORD CHORD BARLINE
{
  // Une mesure en 3/4 faite de trois événements d’accords, généralement trois noires.
  // Utilisé par le matériau de menuet/trio au piano.
  [tonic_pc:$tonic_pc, octave:$octave, accidental_policy:$accidental_policy,
   chords:[root1:$a, q1:$q1, root2:$b, q2:$q2, root3:$c, q3:$q3],
   rhythm:[r1:$r1, r2:$r2, r3:$r3]] ⊂ ↑;
  $pc1_abs = $tonic_pc + $a; $oct1_shift = floor($pc1_abs / 12); $pc1 = $pc1_abs % 12; $o1 = $octave + $oct1_shift;
  $pc2_abs = $tonic_pc + $b; $oct2_shift = floor($pc2_abs / 12); $pc2 = $pc2_abs % 12; $o2 = $octave + $oct2_shift;
  $pc3_abs = $tonic_pc + $c; $oct3_shift = floor($pc3_abs / 12); $pc3 = $pc3_abs % 12; $o3 = $octave + $oct3_shift;
  ↓1 = [];
  ↓2 = [root_pc:$pc1, octave:$o1, dur:$r1, quality:$q1, accidental_policy:$accidental_policy];
  ↓3 = [root_pc:$pc2, octave:$o2, dur:$r2, quality:$q2, accidental_policy:$accidental_policy];
  ↓4 = [root_pc:$pc3, octave:$o3, dur:$r3, quality:$q3, accidental_policy:$accidental_policy];
  ↓5 = [];
  ⇑ = [first_root:$a, last_root:$c, first_pc:$pc1, last_pc:$pc3];
}

