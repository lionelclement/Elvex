// --- Correspondance de rôles spéciale pour les études de gammes -------------
// Dans la grammaire historique, form:scales n’utilisait pas les rôles normaux flute1/piano_rh
// mais routait vers scale_flute_all, scale_piano_rh_all et
// scale_piano_lh_all. Lorsque les entrées ont été convertis vers ensemble.instruments,
// 00_scales_solo_flute.entrée a cessé de produire une sortie parce que ROLE_STAFF
// transmettait role:flute1 à STAFF_MUSIC, alors que scales.rules ne définit
// MUSICAL_FORM que pour role:scale_flute_all.

@withoutSpaces
// -----------------------------------------------------------------------------
// ROLE_STAFF : fabrique une portée LilyPond pour l'instrument courant.
// Les variantes ci-dessous choisissent la bonne clé et le bon type de portée
// selon les traits de l'instrument : clef, family, role et id. Ensuite
// STAFF_MUSIC demande au matériau musical correspondant au role de se réaliser.
// -----------------------------------------------------------------------------
ROLE_STAFF → STAFF_OPEN INSTRUMENT_NAME MIDI_INSTRUMENT TEMPO KEY TIME CLEF_TREBLE DYNAMIC STAFF_MUSIC STAFF_CLOSE
{
  [bpm:$bpm,
   music:[form:scales],
   instrument:[id:$id, name:$name, family:woodwind, role:$role, midi:$midi, clef:treble, octave:$octave, dynamic:$dynamic],
   notation:[accidental_policy:$accidental_policy],
   key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc],
   meter:[num:$num, den:$den]] ⊂ ↑;
  $scale_octave = $octave - 1;
  ↓1 = [];
  ↓2 = [instrument_name:$name];
  ↓3 = [midi_instrument:$midi];
  ↓4 = [bpm:$bpm];
  ↓5 = [tonic:$tonic, mode:$mode];
  ↓6 = [num:$num, den:$den];
  ↓7 = [];
  ↓8 = [dynamic:$dynamic];
  ↓9 = [role:scale_flute_all, form:scales, mode:$mode, tonic_pc:$tonic_pc, octave:$scale_octave, accidental_policy:$accidental_policy, num:$num, den:$den];
  ↓10 = [];
}

