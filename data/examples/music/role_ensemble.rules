// =============================================================================
// role_ensemble.rules
// =============================================================================
// Routage générique par instruments à rôles. Ce module lit ensemble.instruments[count, i1, i2, ...] et crée autant de portées que nécessaire. Chaque instrument reçoit ensuite son role et sa family pour choisir le matériau musical.
//

// -----------------------------------------------------------------------------
// Routage d’ensemble par rôles, représentation indexée avec count explicite.
//
// Les instruments sont déclarés comme traits indexés :
//   ensemble:[instruments:[count:3,
//     i1:[id:flute, role:flute_piano_lead, ...],
//     i2:[id:piano_rh, role:piano_acc_rh, ...],
//     i3:[id:piano_lh, role:piano_acc_lh, ...]]]
//
// Le champ count est volontairement explicite. Il empêche les règles SCORE plus courtes
// de correspondre à aussi des ensembles plus grands et évite les variables d’instrument non liées
// dans les expressions arithmétiques comme octave +/- 1.
// La plage supportée est count:1..15.
// -----------------------------------------------------------------------------

@withoutSpaces
// -----------------------------------------------------------------------------
// SCORE : choisit le nombre de portées à partir de ensemble.instruments.count.
// Chaque variante SCORE prépare le contexte d'un instrument i1, i2, ... puis
// appelle ROLE_STAFF autant de fois que nécessaire. L'ordre 1..15 est volontaire
// car count rend les règles disjointes.
// -----------------------------------------------------------------------------
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN ROLE_STAFF PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [generation:[syntax:instrument_roles], ensemble:[instruments:[count:1, i1:$I1]]] ⊂ ↑;
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [instrument:$I1, notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN ROLE_STAFF ROLE_STAFF PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [generation:[syntax:instrument_roles], ensemble:[instruments:[count:2, i1:$I1, i2:$I2]]] ⊂ ↑;
  ↓1 = [];
