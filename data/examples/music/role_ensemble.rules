  ↓5 = ↑ ∪ [instrument:$I2, notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
  ↓9 = [];
}

