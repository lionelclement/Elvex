// =============================================================================
// rock_band.rules
// =============================================================================
// Formes rock pour groupe : voix, guitare, basse, batterie. Utilise les rôles rock_voice, rock_guitar, rock_bass, rock_drums.
//

// -----------------------------------------------------------------------------
// Groupe rock classique : voix + guitare électrique + basse électrique + batterie
// -----------------------------------------------------------------------------
// Module additif sélectionné uniquement par :
//   music:[style:rock, form:rock_song_verse_chorus]
//   ensemble:[type:rock_band]
//
// Cette version évite l’effet « boîte à musique » produit par trop de blocs triadiques réguliers.
// Elle utilise un vocabulaire rock classique : riffs de guitare, mouvement bVII/IV/I,
// cellules vocales pentatoniques/blues, riffs de basse, arrêts, ornements de remplissage et hooks de refrain plus marqués.
// Il s’agit d’un matériau rock classique générique, pas d’une citation d’un morceau.

@withoutSpaces
// -----------------------------------------------------------------------------
// Entrées rock band.
// Chaque rôle du groupe reçoit une forme parallèle : voix, guitare, basse,
// batterie. Les sections ont les mêmes longueurs pour rester synchronisées.
// -----------------------------------------------------------------------------
MUSICAL_FORM → ROCK_VOICE_FORM
{ [role:rock_voice, form:rock_song_verse_chorus]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → ROCK_GUITAR_FORM
{ [role:rock_guitar, form:rock_song_verse_chorus]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → ROCK_BASS_FORM
{ [role:rock_bass, form:rock_song_verse_chorus]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → ROCK_DRUMS_FORM
{ [role:rock_drums, form:rock_song_verse_chorus]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

// 64 mesures au total.
@withoutSpaces
ROCK_VOICE_FORM → ROCK_VOICE_INTRO_4 ROCK_VOICE_VERSE1_12 ROCK_VOICE_PRE_8 ROCK_VOICE_CHORUS_12 ROCK_VOICE_VERSE2_12 ROCK_VOICE_BRIDGE_8 ROCK_VOICE_FINAL_CHORUS_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ⇑=[cadence:authentic]; }

@withoutSpaces
ROCK_GUITAR_FORM → ROCK_GTR_INTRO_4 ROCK_GTR_VERSE1_12 ROCK_GTR_PRE_8 ROCK_GTR_CHORUS_12 ROCK_GTR_VERSE2_12 ROCK_GTR_BRIDGE_8 ROCK_GTR_FINAL_CHORUS_8
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ↓7=↑; ⇑=[cadence:authentic]; }

