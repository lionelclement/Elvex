// -----------------------------------------------------------------------------
// Routages expérimentaux d’ensemble fondés sur les familles.
// Ils sont volontairement additifs : les routages flûte/piano existantes ne changent pas.
// Chaque ensemble concret associe les instruments à des rôles musicaux génériques comme
// lead, support, inner_voice, bass, harmonic_support et rhythmic_pedal.
// -----------------------------------------------------------------------------

@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN STRING_QUARTET_SCORE PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[
    form:rounded_binary
          |long_rounded_binary
          |formal_long_rounded_binary], 
    ensemble:[type:string_quartet]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

