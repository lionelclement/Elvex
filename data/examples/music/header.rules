// =============================================================================
// header.rules
// =============================================================================
// En-tête LilyPond et profils de tonalité. Ce module écrit \version, \paper, \header,
// et prépare les traits utiles pour \key, armure et altérations.
//

// Grammaire dérivée du fichier duet.rules fourni.
// Étendue pour quatre routages pratiques d’ensemble :
//   - solo_flute
//   - flute_duet
//   - piano_solo
//   - flute_piano_duet
//
// Le matériau original de duo de flûtes est conservé. Les nouvelles règles de piano ajoutent :
// - main droite : terminaux CHORD pour accords plaqués
// - main gauche : patrons de basse/accompagnement utilisant les terminaux NOTE
//
// Note de conception :
// Le choix de l’instrument et le rôle musical sont séparés. Le matériau de flûte réutilise
//   the original lead/support rules; piano has its own right/left hand roles.

@withoutSpaces
PIECE → VERSION PAPER_NO_TAGLINE HEADER SCORE
{ ↓1 = []; ↓2 = []; ↓3 = ↑; ↓4 = ↑; }

@withoutSpaces
// -----------------------------------------------------------------------------
// HEADER : écrit le bloc \header LilyPond à partir de title et composer.
// -----------------------------------------------------------------------------
HEADER → HEADER_OPEN TITLE COMPOSER HEADER_CLOSE
{
  [title:$title, composer:$composer] ⊂ ↑;
  ↓1 = []; ↓2 = [title:$title]; ↓3 = [composer:$composer]; ↓4 = [];
}

// Mise en page fixe de partition pour deux portées de flûte indépendantes.
// KEY_PROFILE est un enfant silencieux. Il déduit la politique d’orthographe des altérations
// depuis la tonalité quand l’entrée ne fournit pas explicitement de notation.
@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN FLUTE1_STAFF FLUTE2_STAFF PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:rounded_binary|ternary|theme_and_variations|minuet_trio|long_rounded_binary|long_ternary|long_theme_and_variations|long_siciliana|long_gigue|long_march|formal_long_rounded_binary|formal_long_ternary|formal_long_theme_and_variations|formal_long_siciliana|formal_long_gigue|formal_long_march], 
  ensemble:[type:flute_duet]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
  ↓9 = [];
}


// --- Routages de partition supplémentaires ---------------------------------
// Les variantes de SCORE sont sélectionnées par ensemble.type dans music.entrée.
// flute_duet utilise la règle SCORE originale ci-dessus.

// Une portée de flûte, utilisant le matériau original de Flûte I / voix conductrice.
@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN FLUTE_SOLO_STAFF PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:rounded_binary|ternary|theme_and_variations|minuet_trio|long_rounded_binary|long_ternary|long_theme_and_variations|long_siciliana|long_gigue|long_march|formal_long_rounded_binary|formal_long_ternary|formal_long_theme_and_variations|formal_long_siciliana|formal_long_gigue|formal_long_march], 
  ensemble:[type:solo_flute]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

// Piano seul : un PianoStaff contenant main droite et main gauche.
@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN PIANO_STAFF_GROUP PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:rounded_binary|ternary|theme_and_variations|minuet_trio|long_rounded_binary|long_ternary|long_theme_and_variations|long_siciliana|long_gigue|long_march|formal_long_rounded_binary|formal_long_ternary|formal_long_theme_and_variations|formal_long_siciliana|formal_long_gigue|formal_long_march], ensemble:[type:piano_solo]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

// Duo flûte + piano : une portée de flûte suivie d’un PianoStaff.
@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE PAR_OPEN FLUTE_WITH_PIANO_STAFF PIANO_ACCOMP_STAFF_GROUP PAR_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:rounded_binary|ternary|theme_and_variations|minuet_trio|long_rounded_binary|long_ternary|long_theme_and_variations|long_siciliana|long_gigue|long_march|formal_long_rounded_binary|formal_long_ternary|formal_long_theme_and_variations|formal_long_siciliana|formal_long_gigue|formal_long_march], ensemble:[type:flute_piano_duet]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
  ↓9 = [];
}



// form:scales est spécial : les exercices doivent être séquentiels, pas simultanés.
// Ces règles SCORE utilisent donc SEQ_OPEN/SEQ_CLOSE ({ ... }) au lieu de
// PAR_OPEN/PAR_CLOSE (<< ... >>). Chaque exercice commence après le précédent.
@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE SEQ_OPEN SCALE_FLUTE_SEQUENCE SEQ_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:scales], ensemble:[type:solo_flute|flute_duet|flute_piano_duet]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

@withoutSpaces
SCORE → SCORE_OPEN KEY_PROFILE SEQ_OPEN SCALE_PIANO_SEQUENCE SEQ_CLOSE LAYOUT MIDI SCORE_CLOSE
{
  [music:[form:scales], ensemble:[type:piano_solo]];
  ↓1 = [];
  ↓2 = ↑;
  [accidental_policy:$accidental_policy, tonic_pc:$tonic_pc] ⊂ ⇓2;
  [key:[tonic:$tonic, mode:$mode]] ⊂ ↑;
  ↓3 = [];
  ↓4 = ↑ ∪ [notation:[accidental_policy:$accidental_policy], key:[tonic:$tonic, mode:$mode, tonic_pc:$tonic_pc], tonic_pc:$tonic_pc];
  ↓5 = [];
  ↓6 = [];
  ↓7 = [];
  ↓8 = [];
}

// --- Orthographe de tonalité et profil de classes de hauteurs ---------------
// KEY_PROFILE est un enfant silencieux. L’utilisateur écrit seulement key:[tonic:..., mode:...]
// dans les fichiers .entrée. tonic_pc est déduit ici et transmis comme donnée interne.
// Important : la valeur numérique est assignée via $pc pour rester numérique dans
// les règles arithmétiques ultérieures comme $pitch = $tonic_pc + $offset.

@withoutSpaces
// -----------------------------------------------------------------------------
// KEY_PROFILE : transforme key:[tonic, mode] en traits utiles au reste de la
// grammaire, notamment tonic_pc et accidental_policy.
// -----------------------------------------------------------------------------
KEY_PROFILE → EMPTY
{
  [notation:[accidental_policy:$accidental_policy], key:[tonic:c]];
  $pc = 0;
  ↓1 = [];
  ⇑ = [accidental_policy:$accidental_policy, tonic_pc:$pc];
}

@withoutSpaces
KEY_PROFILE → EMPTY
{
  [notation:[accidental_policy:$accidental_policy], key:[tonic:cis]];
  $pc = 1;
  ↓1 = [];
  ⇑ = [accidental_policy:$accidental_policy, tonic_pc:$pc];
}

@withoutSpaces
KEY_PROFILE → EMPTY
{
  [notation:[accidental_policy:$accidental_policy], key:[tonic:des]];
  $pc = 1;
  ↓1 = [];
  ⇑ = [accidental_policy:$accidental_policy, tonic_pc:$pc];
}

