@withoutSpaces
CFC_R_STEP → BAR4
{ ↓1=↑ ∪ [motif:[o1:3, o2:5, o3:7, o4:5], rhythm:[r1:"1/4", r2:"1/4", r3:"1/4", r4:"1/4"]]; ⇑=⇓1; }
