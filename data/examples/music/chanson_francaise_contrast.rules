// =============================================================================
// chanson_francaise_contrast.rules
// =============================================================================
// Variantes contrastées de chanson française : récit bas, grande arche, hook syncopé, ligne descendante.
//

// -----------------------------------------------------------------------------
// Chanson française : variantes mélodiques fortement contrastées
// -----------------------------------------------------------------------------
// Module additif. Ces formes possèdent des profils de contour/rythme distincts afin que
// `Elvex -f` donne des mélodies visiblement différentes, pas seulement des variantes de première analyse.
//
// Formes :
//   chanson_francaise_couplet_refrain_recit_bas
//   chanson_francaise_couplet_refrain_grande_arche
//   chanson_francaise_couplet_refrain_hook_syncopated
//   chanson_francaise_couplet_refrain_descendante
//
// La guitare utilise le CHANSON_GUITAR_FORM stable de chanson_francaise.rules.

@withoutSpaces
MUSICAL_FORM → CFC_RECIT_FORM
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_recit_bas]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_recit_bas]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CFC_ARCHE_FORM
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_grande_arche]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_grande_arche]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CFC_HOOK_FORM
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_hook_syncopated]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_hook_syncopated]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

@withoutSpaces
MUSICAL_FORM → CFC_DESC_FORM
{ [role:chanson_voice, form:chanson_francaise_couplet_refrain_descendante]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }
@withoutSpaces
MUSICAL_FORM → CHANSON_GUITAR_FORM
{ [role:chanson_guitar, form:chanson_francaise_couplet_refrain_descendante]; [num:$num, den:$den] ⊂ ↑; ↓1 = ↑; ⇑ = ⇓1; }

// Même architecture de 72 mesures que la chanson de base.
@withoutSpaces
CFC_RECIT_FORM → CFC_RECIT_INTRO_4 CFC_RECIT_VERSE_16 CFC_RECIT_CHORUS_16 CFC_RECIT_VERSE2_16 CFC_RECIT_CHORUS2_16 CFC_RECIT_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[cadence:authentic]; }
@withoutSpaces
CFC_ARCHE_FORM → CFC_ARCHE_INTRO_4 CFC_ARCHE_VERSE_16 CFC_ARCHE_CHORUS_16 CFC_ARCHE_VERSE2_16 CFC_ARCHE_CHORUS2_16 CFC_ARCHE_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[cadence:authentic]; }
@withoutSpaces
CFC_HOOK_FORM → CFC_HOOK_INTRO_4 CFC_HOOK_VERSE_16 CFC_HOOK_CHORUS_16 CFC_HOOK_VERSE2_16 CFC_HOOK_CHORUS2_16 CFC_HOOK_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[cadence:authentic]; }
@withoutSpaces
CFC_DESC_FORM → CFC_DESC_INTRO_4 CFC_DESC_VERSE_16 CFC_DESC_CHORUS_16 CFC_DESC_VERSE2_16 CFC_DESC_CHORUS2_16 CFC_DESC_OUTRO_4
{ ↓1=↑; ↓2=↑; ↓3=↑; ↓4=↑; ↓5=↑; ↓6=↑; ⇑=[cadence:authentic]; }

// -----------------------------------------------------------------------------
// Plans de sections. Le contraste vient de l’usage de patrons de mesures différents :
// recit_bas       : BAR2 + silences, registre grave, rythme parlé.
// grande_arche    : BAR6/BAR8, ambitus plus large, longues arches ascendantes/descendantes.
// hook_syncopated : hook répété et reconnaissable avec contretemps/silences.
// descendante     : contour descendant persistant, cadence nostalgique.
// -----------------------------------------------------------------------------

