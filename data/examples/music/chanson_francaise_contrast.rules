// -----------------------------------------------------------------------------
// Cellules de mesure
// -----------------------------------------------------------------------------
@withoutSpaces
CFC_R_LOW1 → BAR2
{ ↓1=↑ ∪ [motif:[o1:0, o2:3], rhythm:[r1:"1/2", r2:"1/2"]]; ⇑=⇓1; }
@withoutSpaces
CFC_R_LOW2 → BAR4_REST_AFTER_1
{ ↓1=↑ ∪ [motif:[o1:2, o2:0, o3:3], rhythm:[r1:"1/4", rr:"1/4", r2:"1/8", r3:"3/8"]]; ⇑=⇓1; }
