S → ADJ
{
  [mod:<$M1>];

  ↓1 = $M1;

  ⇑ = ↑;
}

S → ADJ ADJ
{
  [mod:<$M1,$M2>];

  ↓1 = $M1;
  ↓2 = $M2;

  order by <⇓1.rank, ⇓2.rank>;

  ⇑ = ↑;
}

